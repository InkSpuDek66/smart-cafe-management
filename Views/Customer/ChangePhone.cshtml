@* Views/Customer/ChangePhone.cshtml *@
@* -------------------------------------------------------
- หน้าเปลี่ยนเบอร์โทรศัพท์ (สำหรับลูกค้า)
- STEP 1: ยืนยันตัวตนด้วยการกรอกชื่อ, นามสกุล, วันเกิด (ข้อมูลต้องตรงกับที่สมัครไว้)
- STEP 2: กรอกเบอร์โทรใหม่และยืนยันเบอร์ใหม่อีกครั้ง
- แสดงข้อความผิดพลาดหากข้อมูลไม่ถูกต้อง เช่น ยืนยันตัวตนไม่สำเร็จ, เบอร์โทรใหม่ไม่ตรงกัน หรือรูปแบบเบอร์โทรไม่ถูกต้อง
- หลังเปลี่ยนเบอร์สำเร็จให้แสดงข้อความ "เปลี่ยนเบอร์โทรสำเร็จ" และลิงก์กลับไปที่หน้า EditProfile
- ใช้ Layout เดียวกับหน้าอื่นๆ ใน Customer (เช่น EditProfile) เพื่อความสอดคล้อง
- URL เข้าถึง: /Customer/ChangePhone
- Method: POST (ยืนยันตัวตนและเปลี่ยนเบอร์)
- Controller Action: CustomerController.ChangePhone (POST)
   ------------------------------------------------------- *@
@{
    ViewData["Title"] = "เปลี่ยนเบอร์โทร";
    Layout = "_MobileLayout";
    bool verified = ViewBag.VerifiedForChange == true;
    ViewBag.CartCount = 0;
}

<div class="p-4">

    <a href="@Url.Action("EditProfile", "Customer")"
       class="inline-flex items-center gap-1 text-[#6F4E37] text-sm font-bold no-underline mb-4">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        กลับ
    </a>

    <h2 class="text-[1.25rem] font-bold text-[#3E2723] mb-1">เปลี่ยนเบอร์โทร</h2>
    <p class="text-[0.8rem] text-[#8D6748] mb-4">
        @(verified ? "ยืนยันตัวตนสำเร็จ — กรอกเบอร์โทรใหม่" : "ยืนยันตัวตนก่อนเปลี่ยนเบอร์")
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="bg-red-50 border border-red-300 rounded-xl px-4 py-3 mb-4 text-[0.82rem] text-red-800">
            @ViewBag.Error
        </div>
    }

    <div class="bg-white rounded-xl border border-[#EFE0C9] overflow-hidden mb-4">

        @if (!verified)
        {
            <!-- STEP 1: ยืนยันตัวตน -->
            <div class="bg-amber-500 text-white px-4 py-3 font-bold text-sm">ขั้นที่ 1 — ยืนยันตัวตน</div>
            <form asp-action="ChangePhone" asp-controller="Customer" method="post">
                <div class="p-4 flex flex-col gap-3.5">
                    <div class="bg-amber-50 rounded-lg px-3.5 py-2.5 text-[0.78rem] text-amber-800">
                        กรอกข้อมูลให้ตรงกับที่ลงทะเบียนไว้ เพื่อยืนยันว่าเป็นเจ้าของบัญชี
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[0.75rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1">ชื่อ *</label>
                            <input type="text" name="verifyFirstName" required
                                   class="w-full border-[1.5px] border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-[#fefaf6] outline-none" />
                        </div>
                        <div>
                            <label class="block text-[0.75rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1">นามสกุล *</label>
                            <input type="text" name="verifyLastName" required
                                   class="w-full border-[1.5px] border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-[#fefaf6] outline-none" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-[0.75rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1">วันเกิด *</label>
                        <input type="date" name="verifyBirthDate" required
                               class="w-full border-[1.5px] border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-[#fefaf6] outline-none" />
                        <div class="text-[0.68rem] text-amber-700 mt-0.5">กรอกวันเกิด ปี ค.ศ. ตรงกับที่สมัครไว้ เช่น 1995</div>
                    </div>

                </div>
                <div class="px-4 pb-4">
                    <button type="submit"
                            class="w-full bg-amber-600 text-white border-none py-3 rounded-xl text-base font-bold cursor-pointer">
                        ยืนยันตัวตน
                    </button>
                </div>
            </form>
        }
        else
        {
            <!-- STEP 2: กรอกเบอร์ใหม่ -->
            <div class="bg-green-600 text-white px-4 py-3 font-bold text-sm">ขั้นที่ 2 — กรอกเบอร์โทรใหม่</div>
            <form asp-action="ChangePhone" asp-controller="Customer" method="post">
                <div class="p-4 flex flex-col gap-3.5">
                    <div>
                        <label class="block text-[0.75rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1">เบอร์โทรใหม่ *</label>
                        <input type="tel" name="newPhone" id="newPhoneInput" required
                               inputmode="numeric" maxlength="10" pattern="[0-9]{10}"
                               placeholder="0812345678"
                               class="w-full border-[1.5px] border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-[#fefaf6] outline-none" />
                    </div>
                    <div>
                        <label class="block text-[0.75rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1">ยืนยันเบอร์โทรใหม่ *</label>
                        <input type="tel" name="confirmPhone" id="confirmPhoneInput" required
                               inputmode="numeric" maxlength="10" pattern="[0-9]{10}"
                               placeholder="0812345678"
                               class="w-full border-[1.5px] border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-[#fefaf6] outline-none" />
                    </div>
                </div>
                <div class="px-4 pb-4">
                    <button type="submit"
                            class="w-full bg-[#6F4E37] text-white border-none py-3 rounded-xl text-base font-bold cursor-pointer">
                        เปลี่ยนเบอร์โทร
                    </button>
                </div>
            </form>
        }

    </div>

</div>

<script>
    // กรองตัวเลขสำหรับช่องเบอร์โทร
    ['newPhoneInput', 'confirmPhoneInput'].forEach(function(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('keypress', function(e) { if (!/[0-9]/.test(e.key)) e.preventDefault(); });
        el.addEventListener('input', function() { this.value = this.value.replace(/\D/g, '').slice(0, 10); });
    });
</script>
