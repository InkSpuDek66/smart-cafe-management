@* Views/Customer/Payment.cshtml *@
@* ------------------------------------------------
- หน้าชำระเงิน (สำหรับลูกค้า)
- แสดงข้อมูลออเดอร์และรายการสินค้า
- ฟอร์มอัปโหลดสลิปการชำระเงิน
- URL เข้าถึง: /Customer/Payment/{orderId}
- Method: GET
- ViewModel: Order (ส่งมาจาก Controller)
- Controller Action: CustomerController.Payment (GET)
------------------------------------------------ *@

@using Project_CSI402_T2_Y3.Models.Db
@{
    ViewData["Title"] = "ชำระเงิน";
    Layout = "_MobileLayout";
    var order           = ViewBag.Order as Order;
    var items           = ViewBag.Items as dynamic;
    var existingPayment = ViewBag.ExistingPayment as Payment;
    var memberId        = ViewBag.MemberId as int?;
    var memberName      = ViewBag.MemberName as string;
    var memberPoints    = (int)(ViewBag.MemberPoints ?? 0);
    var memberStamps    = (int)(ViewBag.MemberStamps ?? 0);
    ViewBag.CartCount   = 0;
}

<div class="p-4">

    <!-- หัวข้อ -->
    <h2 class="font-serif text-[1.25rem] font-bold text-[#3E2723] mb-1">
        ชำระเงิน
    </h2>
    <p class="text-[0.8rem] text-[#8D6748] mb-4">ออเดอร์ #@order?.OrderId</p>

    <!-- ยอดที่ต้องชำระ -->
    <div class="text-white rounded-[14px] p-6 mb-4 text-center"
         style="background:linear-gradient(135deg,#6F4E37,#3E2723);">
        <div class="text-[0.8rem] opacity-75 mb-1">ยอดที่ต้องชำระ</div>
        <div class="font-serif text-[2.5rem] font-bold" id="net-amount-display">
            ฿@order?.NetAmount?.ToString("N0")
        </div>
    </div>

    <!-- รายการสินค้า -->
    <div class="bg-white rounded-xl border border-[#EFE0C9] mb-4 overflow-hidden">
        <div class="bg-[#EFE0C9] px-4 py-2.5 text-[0.78rem] font-bold text-[#6F4E37]">
            รายการสินค้า
        </div>
        @if (items != null)
        {
            @foreach (var row in items)
            {
                <div class="flex justify-between px-4 py-2.5 border-b border-[#f3f4f6] text-sm">
                    <span>@row.mi.MenuName × @row.oi.Quantity</span>
                    <span class="font-semibold text-[#6F4E37]">฿@((row.oi.UnitPrice * row.oi.Quantity)?.ToString("N0"))</span>
                </div>
            }
        }
    </div>

    @if (memberId.HasValue)
    {
        <!-- กล่องแลกแต้ม/Stamp — แสดงเฉพาะสมาชิกและออเดอร์ที่ยังรอชำระ -->
        <div class="bg-white rounded-xl border border-[#EFE0C9] mb-4 overflow-hidden">
            <div class="bg-[#EFE0C9] px-4 py-2.5 flex items-center justify-between">
                <div>
                    <div class="text-[0.78rem] font-bold text-[#6F4E37]">สิทธิพิเศษสมาชิก</div>
                    <div class="text-[0.7rem] text-[#8D6748]">@memberName</div>
                </div>
                <div class="flex gap-3 text-right">
                    <div>
                        <div class="text-[0.65rem] text-[#8D6748]">แต้มสะสม</div>
                        <div class="font-bold text-[#6F4E37] text-sm" id="member-points-display">@memberPoints</div>
                    </div>
                    <div>
                        <div class="text-[0.65rem] text-[#8D6748]">Stamp</div>
                        <div class="font-bold text-[#6F4E37] text-sm" id="member-stamps-display">@memberStamps/10</div>
                    </div>
                </div>
            </div>
            <div class="p-4 flex flex-col gap-2.5">

                @if (memberPoints > 0)
                {
                    <!-- แลกแต้ม: 1 แต้ม = ลด 1 บาท -->
                    <div>
                        <div class="text-[0.75rem] text-gray-500 mb-1.5">แลกแต้มลดราคา (1 แต้ม = 1 บาท)</div>
                        <div class="flex items-center gap-2">
                            <input type="number" id="redeem-points-input"
                                   min="1" max="@memberPoints" value="1"
                                   class="w-20 border border-[#d9c9b6] rounded-lg px-3 py-2 text-sm text-center bg-[#fefaf6] outline-none" />
                            <span class="text-[0.72rem] text-gray-400">แต้ม (มีทั้งหมด @memberPoints)</span>
                            <button type="button" onclick="customerRedeemPoints()"
                                    class="ml-auto bg-[#6F4E37] text-white text-[0.8rem] font-bold px-4 py-2 rounded-lg border-none cursor-pointer">
                                แลกแต้ม
                            </button>
                        </div>
                    </div>
                }

                @if (memberStamps >= 10)
                {
                    <!-- ใช้ Stamp ฟรีดื่ม -->
                    <div>
                        <div class="text-[0.75rem] text-gray-500 mb-1.5">Stamp Card — ครบ 10 ดวงรับฟรี 1 แก้ว</div>
                        <button type="button" onclick="customerRedeemStamp()"
                                class="w-full bg-amber-600 text-white text-sm font-bold py-2.5 rounded-lg border-none cursor-pointer">
                            ใช้ 10 Stamp — รับเครื่องดื่มฟรี 1 แก้ว
                        </button>
                    </div>
                }

                @if (memberPoints == 0 && memberStamps < 10)
                {
                    <div class="text-[0.78rem] text-gray-400 text-center py-1">
                        ยังไม่มีแต้มหรือ Stamp ที่สามารถแลกได้ในขณะนี้
                    </div>
                }

                <!-- ข้อความยืนยันเมื่อแลกสำเร็จ -->
                <div id="redeem-success-msg" class="hidden rounded-lg bg-green-50 border border-green-200 px-3 py-2 text-[0.8rem] text-green-700 font-semibold text-center"></div>
            </div>
        </div>
    }

    @if (existingPayment?.PaymentStatusId == 1)
    {
        <!-- อัปโหลดแล้ว รอตรวจสอบ -->
        <div class="bg-amber-50 border border-yellow-300 rounded-xl p-4 mb-4 text-center">
            <div class="text-[1.5rem] mb-1.5">⏳</div>
            <div class="font-bold text-amber-800">อัปโหลดสลิปแล้ว — รอพนักงานตรวจสอบ</div>
            <div class="text-[0.8rem] text-amber-800 mt-1">ระบบจะอัปเดตสถานะโดยอัตโนมัติ</div>
        </div>
        <a href="@Url.Action("Tracking", "Customer", new { orderId = order?.OrderId })"
           class="block bg-[#6F4E37] text-white text-center py-3.5 rounded-xl font-bold no-underline mb-3">
            ติดตามสถานะออเดอร์
        </a>
    }

    <!-- ฟอร์มอัปโหลดสลิป -->
    <div class="bg-white rounded-xl border border-[#EFE0C9] overflow-hidden mb-4">
        <div class="bg-[#6F4E37] text-white px-4 py-3 font-bold text-sm">
            @(existingPayment != null ? "อัปโหลดสลิปใหม่" : "อัปโหลดหลักฐานการโอนเงิน")
        </div>
        <div class="p-4">

            <!-- ขั้นตอน -->
            <div class="text-[0.8rem] text-gray-500 mb-4 leading-loose">
                1. โอนเงิน <strong class="text-[#3E2723]">฿@order?.NetAmount?.ToString("N0")</strong> ไปยังบัญชีร้าน<br/>
                2. บันทึกหน้าจอสลิปการโอน<br/>
                3. กดเลือกรูปและ "ส่งสลิป" ด้านล่าง
            </div>

            <!-- Mock PromptPay QR -->
            <div class="text-center mb-4">
                <div class="inline-block bg-[#f9f9f9] border-2 border-dashed border-[#C8A97E] rounded-xl p-4">
                    <img src="https://placehold.co/180x180/EFE0C9/6F4E37?text=QR+Code"
                         alt="QR Code" class="w-[180px] h-[180px] rounded-lg" />
                    <div class="text-[0.72rem] text-[#8D6748] mt-2">PromptPay: 0XX-XXX-XXXX</div>
                </div>
            </div>

            <!-- Upload Form -->
            <form asp-action="UploadSlip" asp-controller="Customer"
                  asp-route-orderId="@order?.OrderId"
                  method="post" enctype="multipart/form-data">

                <label class="block w-full border-2 border-dashed border-[#C8A97E] rounded-xl p-6 text-center cursor-pointer bg-[#FDF6EC] mb-3.5"
                       id="dropZone">
                    <!-- Inbox icon — Heroicons outline (อัปโหลดสลิป) -->
                    <svg class="w-9 h-9 text-[#C8A97E] mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                    </svg>
                    <div id="dropLabel" class="text-sm font-bold text-[#6F4E37]">แตะเพื่อเลือกรูปสลิป</div>
                    <div class="text-[0.72rem] text-gray-400 mt-1">JPG, PNG ขนาดไม่เกิน 5MB</div>
                    <input type="file" name="slip" id="slipInput" accept="image/*"
                           class="hidden" required onchange="previewSlip(this)" />
                </label>

                <!-- Preview รูปที่เลือก -->
                <div id="previewDiv" class="hidden text-center mb-3.5">
                    <img id="previewImg" src="" alt="Preview"
                         class="max-w-full max-h-[200px] rounded-xl border border-[#EFE0C9]" />
                </div>

                <button type="submit"
                        class="w-full bg-green-600 text-white border-none py-3.5 rounded-xl text-base font-bold cursor-pointer">
                    ส่งสลิป
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function previewSlip(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('previewImg').src = e.target.result;
                document.getElementById('previewDiv').style.display = 'block';
                document.getElementById('dropLabel').textContent = input.files[0].name;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    var orderId = @(order?.OrderId ?? 0);

    // แสดงข้อความสำเร็จและอัปเดตยอดที่หน้า
    function showRedeemSuccess(msg, newNetAmount) {
        var successEl = document.getElementById('redeem-success-msg');
        successEl.textContent = msg;
        successEl.classList.remove('hidden');

        // อัปเดตยอดที่ต้องชำระบน gradient card
        var netEl = document.getElementById('net-amount-display');
        if (netEl) netEl.textContent = '฿' + newNetAmount.toLocaleString('th-TH', { minimumFractionDigits: 0 });
    }

    function customerRedeemPoints() {
        var pts = parseInt(document.getElementById('redeem-points-input')?.value ?? '0');
        if (!pts || pts <= 0) return;

        fetch('/Customer/RedeemPoints?orderId=' + orderId + '&points=' + pts, { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.ok) { alert(data.message); return; }
                document.getElementById('member-points-display').textContent = data.remainPoints;
                showRedeemSuccess('แลก ' + pts + ' แต้มสำเร็จ — ลดราคา ฿' + pts, data.newNetAmount);
            })
            .catch(function() { alert('เกิดข้อผิดพลาด กรุณาลองใหม่'); });
    }

    function customerRedeemStamp() {
        fetch('/Customer/RedeemStamp?orderId=' + orderId, { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.ok) { alert(data.message); return; }
                document.getElementById('member-stamps-display').textContent = data.remainStamps + '/10';
                showRedeemSuccess('ใช้ 10 Stamp สำเร็จ — รับเครื่องดื่มฟรี ฿' + data.freePrice, data.newNetAmount);
            })
            .catch(function() { alert('เกิดข้อผิดพลาด กรุณาลองใหม่'); });
    }
</script>
