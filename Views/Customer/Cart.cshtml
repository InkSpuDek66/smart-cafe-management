@* Views/Customer/Cart.cshtml *@
@* ------------------------------------------------
- หน้าตะกร้าสินค้า (สำหรับลูกค้า)
- แสดงรายการสินค้าที่เลือกไว้ พร้อมจำนวนและราคารวม
- ฟอร์มปรับจำนวนสินค้า และปุ่มลบสินค้า
- ปุ่มดำเนินการชำระเงิน
- URL เข้าถึง: /Customer/Cart
- Method: GET (แสดงตะกร้า), POST (ปรับจำนวน/ลบสินค้า)
- ViewModel: CartViewModel (ส่งมาจาก Controller)
- Controller Action: CustomerController.Cart (GET/POST)
------------------------------------------------ *@

@model Project_CSI402_T2_Y3.ViewModels.CartViewModel
@{
    ViewData["Title"] = "ตะกร้าสินค้า";
    Layout = "_MobileLayout";
    ViewBag.CartCount = Model.TotalItemCount;
}

<div class="p-4">
    <h2 class="font-serif text-[1.25rem] font-bold text-[#3E2723] mb-4">
        ตะกร้าสินค้า
    </h2>

    @if (!Model.Items.Any())
    {
        <!-- ตะกร้าว่าง -->
        <div class="text-center py-12">
            <!-- Shopping Cart Icon — Heroicons outline (ใช้ stroke-width บางกว่าเพื่อ icon ขนาดใหญ่) -->
            <svg class="w-16 h-16 text-[#C8A97E] mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M9 21a1 1 0 110-2 1 1 0 010 2zm8 0a1 1 0 110-2 1 1 0 010 2z"/>
            </svg>
            <p class="text-gray-400 mb-6">ยังไม่มีสินค้าในตะกร้า</p>
            <a href="@Url.Action("Menu", "Customer", new { table = Model.TableNumber })"
               class="bg-[#6F4E37] text-white px-8 py-3 rounded-xl no-underline font-bold">
                เลือกเมนู
            </a>
        </div>
    }
    else
    {
        <!-- รายการสินค้า -->
        @for (int i = 0; i < Model.Items.Count; i++)
        {
            var ci = Model.Items[i];
            <div class="bg-white rounded-xl border border-[#EFE0C9] p-3.5 mb-3 flex gap-3.5 items-start">

                <!-- รูปสินค้าเล็ก -->
                <div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0">
                    @if (!string.IsNullOrEmpty(ci.ImageUrl))
                    {
                        <img src="@ci.ImageUrl" alt="@ci.MenuName" class="w-full h-full object-cover"
                             onerror="this.src='https://placehold.co/64x64/EFE0C9/6F4E37?text=?'" />
                    }
                    else
                    {
                        <div class="w-full h-full bg-[#EFE0C9] flex items-center justify-center text-[#8D6748] text-[0.65rem] text-center p-1">@ci.MenuName</div>
                    }
                </div>

                <!-- ข้อมูลสินค้า -->
                <div class="flex-1 min-w-0">
                    <div class="font-bold text-[0.9rem] text-[#3E2723] mb-0.5">@ci.MenuName</div>

                    <!-- Options ที่เลือก -->
                    @{
                        var opts = new List<string?> { ci.Sweetness, ci.MilkType, ci.Size };
                        var validOpts = opts.Where(o => !string.IsNullOrEmpty(o)).ToList();
                    }
                    @if (validOpts.Any())
                    {
                        <div class="text-[0.72rem] text-[#8D6748] mb-1">@string.Join(" · ", validOpts)</div>
                    }

                    <!-- ราคาต่อชิ้น -->
                    <div class="text-[0.8rem] text-gray-400">
                        @((ci.UnitPrice + ci.OptionPriceAdjustment).ToString("N0"))฿ / ชิ้น
                    </div>

                    <!-- ควบคุมจำนวน + ราคารวม -->
                    <div class="flex items-center justify-between mt-2">
                        <div class="flex items-center gap-2">
                            <!-- ปุ่มลด -->
                            <form asp-action="UpdateCartQty" asp-controller="Customer" method="post" class="inline">
                                <input type="hidden" name="index" value="@i" />
                                <input type="hidden" name="quantity" value="@(ci.Quantity - 1)" />
                                <button type="submit"
                                        class="w-7 h-7 rounded-full border-[1.5px] border-[#C8A97E] bg-transparent text-[#6F4E37] font-bold cursor-pointer">
                                    -
                                </button>
                            </form>
                            <span class="font-bold min-w-[20px] text-center">@ci.Quantity</span>
                            <!-- ปุ่มเพิ่ม -->
                            <form asp-action="UpdateCartQty" asp-controller="Customer" method="post" class="inline">
                                <input type="hidden" name="index" value="@i" />
                                <input type="hidden" name="quantity" value="@(ci.Quantity + 1)" />
                                <button type="submit"
                                        class="w-7 h-7 rounded-full border-none bg-[#6F4E37] text-white font-bold cursor-pointer">
                                    +
                                </button>
                            </form>
                        </div>

                        <!-- ราคารวมรายการนี้ -->
                        <span class="font-serif font-bold text-[#6F4E37] text-base">
                            @ci.ItemTotal.ToString("N0")฿
                        </span>
                    </div>
                </div>

                <!-- ปุ่มลบ -->
                <form asp-action="RemoveFromCart" asp-controller="Customer" method="post" class="flex-shrink-0">
                    <input type="hidden" name="index" value="@i" />
                    <button type="submit"
                            class="bg-transparent border-none cursor-pointer text-red-500 p-1">
                        <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                    </button>
                </form>
            </div>
        }

        <!-- โปรโมชั่น Free Cookie เมื่อยอดครบ 300 บาท -->
        @if (Model.TotalAmount >= 300)
        {
            <div class="bg-green-50 border-[1.5px] border-green-300 rounded-xl px-4 py-3.5 mb-3 flex items-center gap-3">
                <span class="text-[1.4rem]">🍪</span>
                <div>
                    <div class="font-bold text-green-800 text-[0.9rem]">ยินดีด้วย! คุณได้รับ Cookie ฟรี 1 ชิ้น</div>
                    <div class="text-xs text-green-700 mt-0.5">โปรโมชั่นยอดสั่งซื้อครบ 300฿ — แจ้งพนักงานเพื่อรับสิทธิ์</div>
                </div>
            </div>
        }
        else
        {
            var remaining = 300 - Model.TotalAmount;
            <div class="bg-amber-50 border-[1.5px] border-yellow-300 rounded-xl px-4 py-3 mb-3 flex items-center gap-3">
                <span class="text-[1.2rem]">🍪</span>
                <div class="text-[0.8rem] text-amber-800">
                    สั่งเพิ่มอีก <strong>@remaining.ToString("N0")฿</strong> รับ Cookie ฟรี 1 ชิ้น
                </div>
            </div>
        }

        <!-- สรุปและปุ่มสั่งซื้อ -->
        <div class="bg-white rounded-xl border border-[#EFE0C9] p-4 mt-2">
            <div class="flex justify-between mb-2 text-sm text-gray-500">
                <span>รวม (@Model.TotalItemCount รายการ)</span>
                <span>@Model.TotalAmount.ToString("N0")฿</span>
            </div>
            <div class="flex justify-between font-bold text-base text-[#3E2723] pt-2 border-t border-[#EFE0C9] mb-4">
                <span>ยอดรวมทั้งสิ้น</span>
                <span class="font-serif text-[#6F4E37] text-[1.25rem]">
                    @Model.TotalAmount.ToString("N0")฿
                </span>
            </div>

            <a href="@Url.Action("Checkout", "Customer")"
               class="block bg-[#6F4E37] text-white text-center py-3.5 rounded-xl font-bold text-base no-underline">
                ยืนยันการสั่งซื้อ
            </a>
            <a href="@Url.Action("Menu", "Customer", new { table = Model.TableNumber })"
               class="block text-center py-2.5 text-[#8D6748] text-sm mt-2 no-underline">
                + เพิ่มเมนูอีก
            </a>
        </div>
    }
</div>
