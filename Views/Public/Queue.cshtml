@{
    ViewData["Title"] = "Public Screen";
    Layout = null; // หน้าจอ TV ไม่ใช้ Layout ทั่วไป
    var readyOrders     = ViewBag.ReadyOrders     as IEnumerable<dynamic>;
    var recentCompleted = ViewBag.RecentCompleted as IEnumerable<dynamic>;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Smart Cafe — Public Screen</title>
    <link rel="icon" href="/coffee-removebg-preview.ico" type="image/x-icon" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@700;800&family=Noto+Sans+Thai:wght@400;700&display=swap"
          rel="stylesheet" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Noto Sans Thai', sans-serif;
            background: #1a0f0a;
            color: #fff;
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .screen-header {
            background: #6F4E37;
            padding: 0.75rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .screen-header h1 {
            font-family: 'Noto Sans Thai', sans-serif;
            font-size: 1.5rem;
            color: #F5E6D0;
        }

        .screen-body {
            flex: 1;
            display: grid;
            grid-template-columns: 3fr 1fr;
            gap: 0;
            overflow: hidden;
        }

        /* ===== Panel ซ้าย: คิวพร้อมเสิร์ฟ ===== */
        .ready-panel {
            padding: 1.5rem 2rem;
            overflow-y: auto;
        }

        .ready-label {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #C8A97E;
            margin-bottom: 1rem;
        }

        .queue-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 1rem;
        }

        /* card สีขึ้นอยู่กับ StatusId: paid=น้ำเงิน, preparing=เหลือง, ready=เขียว */
        .queue-card {
            background: #2a1a10;
            border: 2px solid #C8A97E;
            border-radius: 16px;
            padding: 1.5rem;
            text-align: center;
            animation: popIn 0.4s ease;
            transition: border-color 0.3s;
        }

        .queue-card[data-status="2"] { border-color: #60a5fa; }
        .queue-card[data-status="3"] { border-color: #fbbf24; }
        .queue-card[data-status="4"] { border-color: #34d399; }

        .queue-no {
            font-family: 'Inter', 'Noto Sans Thai', sans-serif;
            font-size: 3.5rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            font-variant-numeric: tabular-nums;
            color: #fbbf24;
            line-height: 1;
        }

        .queue-card[data-status="2"] .queue-no { color: #93c5fd; }
        .queue-card[data-status="3"] .queue-no { color: #fbbf24; }
        .queue-card[data-status="4"] .queue-no { color: #6ee7b7; }

        .queue-table {
            font-size: 0.875rem;
            color: #C8A97E;
            margin-top: 0.4rem;
        }

        .status-badge {
            display: inline-block;
            border-radius: 99px;
            padding: 0.2rem 0.7rem;
            font-size: 0.7rem;
            font-weight: 700;
            margin-top: 0.5rem;
            letter-spacing: 0.06em;
        }

        .badge-paid      { background: #1d4ed8; color: #bfdbfe; }
        .badge-preparing { background: #92400e; color: #fef3c7; }
        .badge-ready     { background: #15803d; color: #dcfce7; }

        .empty-ready {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 60vh;
            text-align: center;
            color: #feedd3;
            font-size: 2rem;
            font-weight: 500;
            letter-spacing: 0.02em;
        }

        /* ===== Panel ขวา: เพิ่งเสร็จ ===== */
        .done-panel {
            background: #12090600;
            border-left: 1px solid #3a2010;
            padding: 1.5rem 1rem;
        }

        .done-label {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #6b7280;
            margin-bottom: 0.75rem;
        }

        .done-item {
            padding: 0.5rem 0.6rem;
            border-bottom: 1px solid #2a1a10;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .done-queue-no {
            font-size: 1.1rem;
            font-weight: 700;
            color: #6b7280;
            text-decoration: line-through;
        }

        /* ===== Footer ===== */
        .screen-footer {
            background: #2a1a10;
            padding: 0.4rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .clock {
            font-size: 1.5rem;
            font-weight: 700;
            color: #C8A97E;
        }

        @@keyframes popIn {
            from { transform: scale(0.8); opacity: 0; }
            to   { transform: scale(1);   opacity: 1; }
        }

        /* SignalR แจ้งเตือน */
        .notify-bar {
            position: fixed;
            bottom: 3rem;
            left: 50%;
            transform: translateX(-50%);
            background: #fbbf24;
            color: #1a0f0a;
            padding: 0.75rem 2rem;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 700;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
            z-index: 100;
            display: none;
        }
    </style>
</head>
<body>

    <div class="screen-header">
        <h1>Smart Cafe</h1>
        <div style="font-size:0.875rem;color:#F5E6D0;opacity:0.8;">กรุณาพักรอบริเวณเคาน์เตอร์</div>
    </div>

    <div class="screen-body">

        <!-- คิวพร้อมเสิร์ฟ -->
        <div class="ready-panel">
            <div class="ready-label">พร้อมรับออเดอร์</div>
            <div class="queue-grid" id="queueGrid">
                @if (readyOrders == null || !readyOrders.Any())
                {
                    <div class="empty-ready">
                        ไม่มีออเดอร์ในขณะนี้
                    </div>
                }
                else
                {
                    @foreach (var o in readyOrders)
                    {
                        string badgeClass = ((int)o.StatusId) switch
                        {
                            2 => "badge-paid",
                            3 => "badge-preparing",
                            4 => "badge-ready",
                            _ => "badge-ready"
                        };
                        <div class="queue-card" data-order-id="@o.OrderId" data-status="@o.StatusId">
                            <div class="queue-no">@o.QueueNumber</div>
                            @if (!string.IsNullOrEmpty((string)o.TableNumber))
                            {
                                <div class="queue-table">โต๊ะ @o.TableNumber</div>
                            }
                            <div><span class="status-badge @badgeClass">@o.StatusLabel</span></div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- คิวเพิ่งเสิร์ฟ -->
        <div class="done-panel">
            <div class="done-label">เสร็จแล้ว</div>
            @if (recentCompleted != null)
            {
                @foreach (var o in recentCompleted)
                {
                    <div class="done-item">
                        <span class="done-queue-no">@o.QueueNumber</span>
                    </div>
                }
            }
        </div>

    </div>

    <div class="screen-footer">
        <div style="font-size:0.75rem;color:#6b7280;">Public Screen v1.0</div>
        <div class="clock" id="clock">--:--:--</div>
        <div style="font-size:0.75rem;color:#6b7280;" id="refreshIn">Auto-refresh 10s</div>
    </div>

    <!-- Toast แจ้งเตือนคิวใหม่ -->
    <div class="notify-bar" id="notifyBar"></div>

</body>

<!-- SignalR Client — Public Screen Join กลุ่ม "public" -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
    // นาฬิกา
    function updateClock() {
        var now = new Date();
        document.getElementById('clock').textContent =
            String(now.getHours()).padStart(2,'0') + ':' +
            String(now.getMinutes()).padStart(2,'0') + ':' +
            String(now.getSeconds()).padStart(2,'0');
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Auto-refresh ทุก 10 วินาที
    var countdown = 10;
    setInterval(function () {
        countdown--;
        document.getElementById('refreshIn').textContent = 'Auto-refresh ' + countdown + 's';
        if (countdown <= 0) location.reload();
    }, 1000);

    // SignalR — รับ NotifyOrderReady และอัปเดต UI ทันที
    var connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/cafe")
        .withAutomaticReconnect()
        .build();

    connection.on("NotifyOrderReady", function (data) {
        // แสดง toast
        var bar = document.getElementById('notifyBar');
        bar.textContent = 'คิว ' + data.queueNumber + ' พร้อมรับแล้ว!';
        bar.style.display = 'block';
        setTimeout(function () { bar.style.display = 'none'; }, 4000);

        var grid = document.getElementById('queueGrid');

        // อัปเดต card ที่มีอยู่แล้วให้แสดงสถานะ Ready แทนการสร้างใหม่
        var existing = grid.querySelector('[data-order-id="' + data.orderId + '"]');
        if (existing) {
            existing.setAttribute('data-status', '4');
            var badge = existing.querySelector('.status-badge');
            if (badge) {
                badge.className = 'status-badge badge-ready';
                badge.textContent = 'พร้อมรับ';
            }
            var queueNo = existing.querySelector('.queue-no');
            if (queueNo) queueNo.style.color = '#6ee7b7';
            return;
        }

        // ถ้ายังไม่มี card → สร้างใหม่ (กรณี page ยังไม่ reload)
        var empty = grid.querySelector('.empty-ready');
        if (empty) empty.remove();

        var card = document.createElement('div');
        card.className = 'queue-card';
        card.setAttribute('data-order-id', data.orderId);
        card.setAttribute('data-status', '4');
        card.innerHTML = '<div class="queue-no" style="color:#6ee7b7;">' + data.queueNumber + '</div>'
                       + '<div><span class="status-badge badge-ready">พร้อมรับ</span></div>';
        grid.appendChild(card);
    });

    // ลบ card ออกทันทีเมื่อ Cashier กด "ส่งลูกค้าแล้ว"
    connection.on("NotifyOrderCompleted", function (data) {
        var grid = document.getElementById('queueGrid');
        var card = grid.querySelector('[data-order-id="' + data.orderId + '"]');
        if (card) card.remove();

        // ถ้าไม่มี card เหลือแล้ว แสดงข้อความ empty
        var remaining = grid.querySelectorAll('.queue-card');
        if (remaining.length === 0) {
            var empty = document.createElement('div');
            empty.className = 'empty-ready';
            empty.textContent = 'ไม่มีออเดอร์พร้อมเสิร์ฟในขณะนี้';
            grid.appendChild(empty);
        }

        // เพิ่มรายการในช่อง "เสร็จแล้ว" panel ขวา
        var donePanel = document.querySelector('.done-panel');
        var doneList  = donePanel ? donePanel.querySelectorAll('.done-item') : [];

        // ถ้ามีครบ 5 แล้ว ลบอันเก่าสุดออก
        if (doneList.length >= 5) doneList[doneList.length - 1].remove();

        var firstItem = donePanel ? donePanel.querySelector('.done-item') : null;
        var newItem   = document.createElement('div');
        newItem.className = 'done-item';
        newItem.innerHTML = '<span class="done-queue-no">' + data.queueNumber + '</span>';
        if (firstItem) {
            donePanel.insertBefore(newItem, firstItem);
        } else if (donePanel) {
            donePanel.appendChild(newItem);
        }
    });

    connection.start()
        .then(function () { return connection.invoke("JoinGroup", "public"); })
        .catch(function (err) { console.error("SignalR Public connect error:", err); });
</script>
</html>
