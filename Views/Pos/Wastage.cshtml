@* Views/Pos/Wastage.cshtml *@
@* ------------------------------------------------
- หน้า Wastage สำหรับบันทึกการเสียวัตถุดิบ (สำหรับ Staff และ Admin)
- ฟอร์มกรอกข้อมูล: เลือกวัตถุดิบ, ปริมาณที่เสีย
- แสดงสต็อกปัจจุบันของวัตถุดิบที่เลือกแบบ real-time
- แสดงประวัติการบันทึก Wastage ล่าสุด 20 รายการ
- URL เข้าถึง: /Pos/Wastage
- Method: GET (แสดงฟอร์ม), POST (บันทึกข้อมูล)
- ViewModel: ไม่มี (ใช้ ViewBag ส่งข้อมูลวัตถุดิบและประวัติ)
- Controller Action: PosController.Wastage (GET/POST)
------------------------------------------------ *@

@{
    ViewData["Title"] = "บันทึก Wastage";
    Layout = "_AdminLayout";
    var ingredients = ViewBag.Ingredients as List<Project_CSI402_T2_Y3.ViewModels.PosWastageViewModel>;
    var recentLogs  = ViewBag.RecentLogs as IEnumerable<dynamic>;
}

<div class="max-w-[900px]">

    <!-- ปุ่มกลับ -->
    <a asp-controller="Pos" asp-action="Queue"
       class="inline-flex items-center gap-1 text-[#6F4E37] text-sm font-bold no-underline mb-4">
        ← กลับ Queue
    </a>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error mb-4 text-sm">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4 text-sm">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            <span>@TempData["Success"]</span>
        </div>
    }

    <div class="grid grid-cols-[1fr_1.5fr] gap-6 items-start">

        <!-- ===== ฟอร์มบันทึก Wastage ===== -->
        <div class="admin-card">
            <div class="admin-card-header">บันทึก Wastage</div>
            <div class="admin-card-body">
                <form asp-controller="Pos" asp-action="Wastage" method="post" id="wastageForm">

                    <!-- เลือกวัตถุดิบ -->
                    <div class="mb-4">
                        <label class="block text-[0.78rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1.5">
                            วัตถุดิบ *
                        </label>
                        <select name="ingredientId" id="ingredientSelect" required onchange="updateStock(this)"
                                class="w-full border-[1.5px] border-[#d9c9b6] rounded-lg px-3.5 py-2.5 text-sm bg-[#fefaf6] outline-none">
                            <option value="">-- เลือกวัตถุดิบ --</option>
                            @if (ingredients != null)
                            {
                                @foreach (var ing in ingredients)
                                {
                                    <option value="@ing.IngredientId"
                                            data-stock="@ing.StockQuantity"
                                            data-unit="@ing.Unit">
                                        @ing.IngredientName (@ing.StockQuantity?.ToString("N2") @ing.Unit)
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- สต็อกปัจจุบัน (แสดง real-time เมื่อเลือก) -->
                    <div id="stockInfo" class="hidden mb-4 bg-amber-50 rounded-md px-3 py-2 text-[0.82rem]">
                        สต็อกปัจจุบัน:
                        <strong id="stockVal" class="font-['Inter'] tabular-nums">—</strong>
                        <span id="stockUnitLabel" class="text-gray-500"></span>
                    </div>

                    <!-- ปริมาณที่เสีย -->
                    <div class="mb-4">
                        <label class="block text-[0.78rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1.5">
                            ปริมาณที่เสีย *
                        </label>
                        <div class="flex gap-2 items-center">
                            <input type="number" name="quantity" id="quantityInput"
                                   min="0.001" step="0.001" required
                                   oninput="validateQuantity(this)"
                                   class="flex-1 border-[1.5px] border-[#d9c9b6] rounded-lg px-3.5 py-2.5 text-sm bg-[#fefaf6] outline-none" />
                            <!-- แสดงหน่วยถัดจากช่อง input -->
                            <span id="unitLabel" class="text-sm font-bold text-[#6F4E37] min-w-[40px]">—</span>
                        </div>
                        <!-- คำเตือนเมื่อปริมาณเกิน stock -->
                        <div id="quantityWarning" class="hidden mt-1.5 text-[0.75rem] text-red-600 font-semibold">
                            ปริมาณเกินสต็อกที่มีอยู่
                        </div>
                    </div>

                    <!-- หมายเหตุ / สาเหตุ -->
                    <div class="mb-4">
                        <label class="block text-[0.78rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1.5">
                            หมายเหตุ / สาเหตุ
                        </label>
                        <textarea name="notes" rows="2" maxlength="500" placeholder="เช่น ของหมดอายุ, ทำหกเลอะ, ..."
                                  class="w-full border-[1.5px] border-[#d9c9b6] rounded-lg px-3.5 py-2 text-sm bg-[#fefaf6] outline-none resize-none"></textarea>
                    </div>

                    <button type="submit" id="submitBtn"
                            class="w-full bg-amber-400 text-white border-none rounded-lg py-3 text-sm font-bold cursor-pointer">
                        บันทึก Wastage
                    </button>
                </form>
            </div>
        </div>

        <!-- ===== ประวัติ Wastage ล่าสุด ===== -->
        <div class="admin-card">
            <div class="admin-card-header">ประวัติ Wastage (20 รายการล่าสุด)</div>
            <div class="admin-card-body p-0">
                @if (recentLogs == null || !recentLogs.Any())
                {
                    <div class="p-8 text-center text-gray-400 text-sm">ยังไม่มีประวัติ Wastage</div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-[0.82rem]">
                            <thead>
                                <tr class="bg-[#f5ede3] border-b border-[#e8d5bf]">
                                    <th class="text-left px-4 py-2.5 text-[0.72rem] font-bold text-[#6F4E37] uppercase tracking-wide">วัตถุดิบ</th>
                                    <th class="text-right px-4 py-2.5 text-[0.72rem] font-bold text-[#6F4E37] uppercase tracking-wide">ปริมาณ</th>
                                    <th class="text-left px-3 py-2.5 text-[0.72rem] font-bold text-[#6F4E37] uppercase tracking-wide">หน่วย</th>
                                    <th class="text-left px-3 py-2.5 text-[0.72rem] font-bold text-[#6F4E37] uppercase tracking-wide">หมายเหตุ</th>
                                    <th class="text-left px-3 py-2.5 text-[0.72rem] font-bold text-[#6F4E37] uppercase tracking-wide">โดย</th>
                                    <th class="text-left px-3 py-2.5 text-[0.72rem] font-bold text-[#6F4E37] uppercase tracking-wide whitespace-nowrap">วันที่ / เวลา</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in recentLogs)
                                {
                                    bool hasNotes = !string.IsNullOrEmpty((string?)log.Notes);
                                    DateTime? logDt = (DateTime?)log.CreatedAt;
                                    <tr class="border-b border-[#f0e4d4] hover:bg-[#fdf8f3] transition-colors">
                                        <td class="px-4 py-3 font-semibold text-[#3E2723]">@log.IngredientName</td>
                                        <td class="px-4 py-3 text-right">
                                            <span class="inline-flex items-center gap-1 bg-red-50 text-red-700 font-bold font-['Inter'] tabular-nums px-2 py-0.5 rounded-md text-[0.8rem]">
                                                −@(Math.Abs((float)log.QuantityChange).ToString("N2"))
                                            </span>
                                        </td>
                                        <td class="px-3 py-3 text-gray-500 text-[0.78rem]">@log.Unit</td>
                                        <td class="px-3 py-3">
                                            @if (hasNotes)
                                            {
                                                <button type="button"
                                                        class="text-[0.75rem] text-amber-700 underline cursor-pointer bg-transparent border-none p-0 font-semibold"
                                                        onclick="toggleNote(this)">
                                                    ดูหมายเหตุ
                                                </button>
                                                <div class="notes-expand hidden mt-1 text-[0.75rem] text-gray-700 bg-amber-50 border border-amber-200 rounded px-2 py-1 max-w-[160px] break-words">
                                                    @log.Notes
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-gray-300">—</span>
                                            }
                                        </td>
                                        <td class="px-3 py-3 text-gray-600 text-[0.8rem]">@log.CreatedBy</td>
                                        <td class="px-3 py-3 text-gray-500 text-[0.78rem] whitespace-nowrap">
                                            @if (logDt.HasValue)
                                            {
                                                <span class="block font-semibold text-gray-700">@logDt.Value.ToString("dd/MM/yyyy")</span>
                                                <span class="text-gray-400">@logDt.Value.ToString("HH:mm")</span>
                                            }
                                            else { <span class="text-gray-300">—</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<script>
    var currentStock = 0;

    // แสดงสต็อกปัจจุบัน + หน่วย เมื่อเลือกวัตถุดิบ
    function updateStock(select) {
        var opt   = select.options[select.selectedIndex];
        var stock = opt.getAttribute('data-stock');
        var unit  = opt.getAttribute('data-unit') || '—';

        if (stock) {
            currentStock = parseFloat(stock) || 0;
            document.getElementById('stockVal').textContent      = currentStock.toFixed(3);
            document.getElementById('stockUnitLabel').textContent = ' ' + unit;
            document.getElementById('stockInfo').classList.remove('hidden');
            document.getElementById('unitLabel').textContent = unit;
        } else {
            currentStock = 0;
            document.getElementById('stockInfo').classList.add('hidden');
            document.getElementById('unitLabel').textContent = '—';
        }
        // ตรวจสอบ quantity ที่กรอกไว้อีกครั้งหลังเปลี่ยนวัตถุดิบ
        validateQuantity(document.getElementById('quantityInput'));
    }

    // ตรวจสอบว่าปริมาณที่กรอกไม่เกิน stock ปัจจุบัน
    function validateQuantity(input) {
        var qty     = parseFloat(input.value) || 0;
        var warning = document.getElementById('quantityWarning');
        var btn     = document.getElementById('submitBtn');

        if (currentStock > 0 && qty > currentStock) {
            warning.classList.remove('hidden');
            btn.disabled  = true;
            btn.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
            warning.classList.add('hidden');
            btn.disabled  = false;
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
    }

    // กดขยาย/ซ่อนหมายเหตุในตารางประวัติ
    function toggleNote(btn) {
        var noteDiv = btn.nextElementSibling;
        if (noteDiv.classList.contains('hidden')) {
            noteDiv.classList.remove('hidden');
            btn.textContent = 'ซ่อน';
        } else {
            noteDiv.classList.add('hidden');
            btn.textContent = 'ดูหมายเหตุ';
        }
    }
</script>
