@* Views/Menu/Index.cshtml *@
@* ------------------------------------------------
- หน้าเมนูอาหาร
- แสดงรายการเมนูอาหารและเครื่องดื่ม
- URL เข้าถึง: /Menu/Index
- Method: GET
- ViewModel: List<Menuitem>
- Controller Action: MenuController.Index (GET)
------------------------------------------------ *@

@model List<Project_CSI402_T2_Y3.Models.Db.Menuitem>
@{
    ViewData["Title"] = "เมนูอาหาร";
    string selectedCategory = ViewBag.SelectedCategory ?? "All";
    List<string> categories = ViewBag.Categories       ?? new List<string>();
}

<!-- Page Header -->
<div class="mb-6">
    <p class="text-xs uppercase tracking-[0.12em] text-[#C8A97E] font-bold mb-1">Smart Cafe</p>
    <h1 class="cf-page-title">เมนูอาหารและเครื่องดื่ม</h1>
    <p class="cf-page-subtitle">@Model.Count รายการ</p>
</div>

<!-- Category Filter -->
<div class="flex flex-wrap gap-2 mb-7">
    <a asp-action="Index" asp-controller="Menu"
       class="btn btn-sm @(selectedCategory == "All" ? "btn-primary" : "btn-ghost")">
        ทั้งหมด
    </a>
    @foreach (var cat in categories)
    {
        <a asp-action="Index" asp-controller="Menu" asp-route-category="@cat"
           class="btn btn-sm @(selectedCategory == cat ? "btn-primary" : "btn-ghost")">
            @cat
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="bg-[#EFE0C9] border border-[#C8A97E] rounded-xl p-10 text-center">
        <p class="text-[#8D6748] text-[0.95rem]">
            @(selectedCategory != "All"
                ? $"ไม่พบเมนูในหมวด \"{selectedCategory}\""
                : "ยังไม่มีเมนูในระบบ")
        </p>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        @foreach (var item in Model)
        {
            bool isUnavailable = item.IsAvailable == (ulong)0;
            bool isSeasonal    = item.IsSeasonal  == (ulong)1;

            <div class="bg-white border border-[#EFE0C9] rounded-xl overflow-hidden shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">

                <!-- รูปภาพหรือ Placeholder — เก็บ linear-gradient สำหรับ placeholder -->
                <div class="h-40 relative flex items-center justify-center"
                     style="background:linear-gradient(135deg,#EFE0C9 0%,#FDF6EC 100%);">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.MenuName"
                             class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <!-- Placeholder ตัวอักษรหมวดหมู่ -->
                        <span class="font-['Playfair_Display'] text-[2.5rem] text-[#C8A97E] opacity-60">
                            @(item.Category?.Substring(0, 1) ?? "C")
                        </span>
                    }

                    <!-- Sold Out Overlay -->
                    @if (isUnavailable)
                    {
                        <div class="absolute inset-0 bg-[rgba(62,39,35,0.55)] flex items-center justify-center">
                            <span class="bg-red-600 text-white text-[0.72rem] font-bold px-3 py-1 rounded uppercase tracking-wider">
                                หมดแล้ว
                            </span>
                        </div>
                    }

                    <!-- Seasonal Badge -->
                    @if (isSeasonal)
                    {
                        <span class="absolute top-2 left-2 bg-[#A0522D] text-white text-[0.68rem] font-bold px-2 py-0.5 rounded uppercase tracking-wider">
                            ฤดูกาล
                        </span>
                    }
                </div>

                <!-- Card Content -->
                <div class="p-4">
                    <h3 class="font-bold text-[0.9rem] text-[#3E2723] mb-1.5 leading-snug">@item.MenuName</h3>

                    @if (!string.IsNullOrEmpty(item.MenuDescription))
                    {
                        <p class="text-[0.78rem] text-[#8D6748] leading-relaxed mb-2 line-clamp-2">
                            @item.MenuDescription
                        </p>
                    }

                    <div class="flex justify-between items-center mt-2">
                        <span class="text-[0.72rem] bg-[#EFE0C9] text-[#8D6748] px-2 py-0.5 rounded border border-[#C8A97E]">
                            @item.Category
                        </span>
                        <span class="font-['Inter'] font-bold text-[#6F4E37] text-base tracking-tight">
                            @item.Price?.ToString("N0") ฿
                        </span>
                    </div>
                </div>

            </div>
        }
    </div>
}
