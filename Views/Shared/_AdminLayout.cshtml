<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin</title>

    <link rel="icon" href="/coffee-removebg-preview.ico" type="image/x-icon" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sarabun:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.14/dist/full.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        :root {
            --cf-dark:    #3E2723;
            --cf-primary: #6F4E37;
            --cf-medium:  #8D6748;
            --cf-latte:   #C8A97E;
            --cf-cream:   #EFE0C9;
            --cf-foam:    #FDF6EC;
            /* บังคับ browser ไม่ให้ใช้ auto dark mode กับหน้านี้ */
            color-scheme: light;
        }

        body {
            font-family: 'Sarabun', sans-serif;
            background-color: #f5f5f5;
            color: #1a1a1a;
        }

        /* ===== Sidebar ===== */
        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 240px;
            background-color: var(--cf-dark);
            z-index: 40;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 1.5rem 1.25rem 1rem;
            border-bottom: 1px solid rgba(200,169,126,0.3);
        }
        .sidebar-brand h1 {
            font-family: 'Inter', sans-serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--cf-latte);
        }
        .sidebar-brand p {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.45);
            margin-top: 2px;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .sidebar-nav { padding: 1rem 0; flex: 1; }

        .nav-section-title {
            padding: 0.6rem 1.25rem 0.3rem;
            font-size: 0.65rem;
            font-weight: 700;
            color: rgba(255,255,255,0.35);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .nav-item a {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.65rem 1.25rem;
            color: rgba(255,255,255,0.65);
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.15s, color 0.15s;
            border-left: 3px solid transparent;
        }
        .nav-item a:hover {
            background-color: rgba(111,78,55,0.4);
            color: #fff;
        }
        .nav-item a.active {
            background-color: rgba(111,78,55,0.5);
            color: var(--cf-latte);
            border-left-color: var(--cf-latte);
        }
        .nav-item svg { width: 18px; height: 18px; flex-shrink: 0; }

        .sidebar-footer {
            padding: 1rem 1.25rem;
            border-top: 1px solid rgba(200,169,126,0.2);
        }
        .sidebar-footer .staff-name {
            font-size: 0.8rem;
            font-weight: 700;
            color: #fff;
        }
        .sidebar-footer .staff-role {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.45);
        }
        .sidebar-footer a {
            display: block;
            margin-top: 0.5rem;
            font-size: 0.75rem;
            color: rgba(255,255,255,0.5);
            text-decoration: none;
        }
        .sidebar-footer a:hover { color: #ef4444; }

        /* ===== Main Content ===== */
        .admin-main {
            margin-left: 240px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .admin-topbar {
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
            padding: 0.875rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 30;
        }
        .page-title-bar {
            font-family: 'Inter', sans-serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--cf-primary);
            letter-spacing: -0.01em;
        }

        .admin-content {
            padding: 1.5rem;
            flex: 1;
        }

        /* ===== Cards ===== */
        .admin-card {
            background: #fff;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            overflow: hidden;
        }
        .admin-card-header {
            padding: 1rem 1.25rem;
            background-color: var(--cf-primary);
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .admin-card-body { padding: 1.25rem; }

        /* ===== Stat Cards ===== */
        .stat-card {
            background: #fff;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            padding: 1.25rem;
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }
        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .stat-icon svg { width: 24px; height: 24px; }
        .stat-label { font-size: 0.78rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.06em; }
        .stat-value { font-family: 'Inter', sans-serif; font-size: 1.9rem; font-weight: 800; color: var(--cf-primary); line-height: 1; letter-spacing: -0.02em; }
        .stat-desc  { font-size: 0.75rem; color: #9ca3af; margin-top: 2px; }

        /* ===== Tables ===== */
        .admin-table th {
            background-color: var(--cf-primary);
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.75rem 1rem;
        }
        .admin-table td { padding: 0.75rem 1rem; border-bottom: 1px solid #f3f4f6; font-size: 0.875rem; color: #1a1a1a; }
        .admin-table tr:hover td { background-color: #fdf6ec; }

        /* override DaisyUI table-zebra — บังคับ tbody พื้นหลังสว่าง ป้องกันตัวอักษรหาย */
        .table-zebra tbody tr:nth-child(odd) td  { background-color: #ffffff !important; color: #1a1a1a !important; }
        .table-zebra tbody tr:nth-child(even) td { background-color: #f9fafb !important; color: #1a1a1a !important; }
        .table-zebra tbody tr:hover td           { background-color: #fdf6ec !important; color: #1a1a1a !important; }
        .table thead th { background-color: var(--cf-primary) !important; color: #fff !important; }
        .table td, .table th { border-color: #e5e7eb !important; }

        /* ===== Buttons ===== */
        .btn-cf-primary {
            background-color: var(--cf-primary);
            color: #fff;
            border: none;
            padding: 0.5rem 1.25rem;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.875rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: background 0.18s;
        }
        .btn-cf-primary:hover { background-color: var(--cf-dark); color: #fff; }

        .btn-cf-outline {
            background-color: transparent;
            color: var(--cf-primary);
            border: 1.5px solid var(--cf-primary);
            padding: 0.45rem 1rem;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.875rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.18s;
        }
        .btn-cf-outline:hover { background-color: var(--cf-primary); color: #fff; }

        .btn-success { background-color: #16a34a !important; color: #fff !important; }
        .btn-success:hover { background-color: #15803d !important; }

        .btn-danger { background-color: #dc2626 !important; color: #fff !important; border: none; }
        .btn-danger:hover { background-color: #b91c1c !important; }

        /* ===== Flash ===== */
        .flash-success {
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #6ee7b7;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            font-size: 0.875rem;
        }
        .flash-error {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            font-size: 0.875rem;
        }

        /* ===== Badge ===== */
        .status-badge {
            display: inline-block;
            padding: 0.2rem 0.6rem;
            border-radius: 12px;
            font-size: 0.72rem;
            font-weight: 700;
        }
        .badge-warning  { background-color: #fef3c7; color: #92400e; }
        .badge-info     { background-color: #dbeafe; color: #1e40af; }
        .badge-primary  { background-color: #ede9fe; color: #5b21b6; }
        .badge-success  { background-color: #d1fae5; color: #065f46; }
        .badge-neutral  { background-color: #f3f4f6; color: #374151; }
        .badge-error    { background-color: #fee2e2; color: #991b1b; }

        /* ===== Stat Card แบบ cf- prefix ใช้ใน Reports/Finance ===== */
        .cf-stat-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 1.25rem 1.5rem;
        }
        .cf-stat-card .cf-stat-label {
            font-size: 0.72rem;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            margin-bottom: 0.3rem;
        }
        .cf-stat-card .cf-stat-value {
            font-family: 'Inter', sans-serif;
            font-size: 1.9rem;
            font-weight: 800;
            color: var(--cf-primary);
            line-height: 1;
            letter-spacing: -0.02em;
        }
        .cf-stat-card .cf-stat-desc {
            font-size: 0.72rem;
            color: #9ca3af;
            margin-top: 0.25rem;
        }

        /* ===== Badge ตาม pending count ===== */
        .nav-badge {
            background-color: #ef4444;
            color: #fff;
            border-radius: 10px;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 1px 6px;
            margin-left: auto;
        }

        /* ===== Responsive — ซ่อน Sidebar บนมือถือ ===== */
        @@media (max-width: 768px) {
            .admin-sidebar { display: none; }
            .admin-main { margin-left: 0; }
        }

    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <h1>Smart Cafe</h1>
            <p>Admin Panel</p>
        </div>

        <nav class="sidebar-nav">
            @{
                var roleId      = Context.Session.GetInt32("StaffRoleId");
                var action      = ViewContext.RouteData.Values["action"]?.ToString();
                var controller  = ViewContext.RouteData.Values["controller"]?.ToString();
            }

            <div class="nav-section-title">ภาพรวม</div>
            <div class="nav-item">
                <a asp-controller="Admin" asp-action="Index"
                   class="@(controller == "Admin" && action == "Index" ? "active" : "")">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    Dashboard
                </a>
            </div>

            <!-- POS — Barista (1) และ Cashier (2) ใช้หลัก -->
            <div class="nav-section-title">POS</div>
            <div class="nav-item">
                <a asp-controller="Pos" asp-action="Queue"
                   class="@(controller == "Pos" && action == "Queue" ? "active" : "")">
                    <!-- Clipboard list icon — Heroicons outline (Order Queue) -->
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                    </svg>
                    Order Queue
                </a>
            </div>
            <div class="nav-item">
                <a asp-controller="Pos" asp-action="Kds"
                   class="@(controller == "Pos" && action == "Kds" ? "active" : "")">
                    <!-- Inbox icon — Heroicons outline (KDS Barista) -->
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                    </svg>
                    KDS (Barista)
                </a>
            </div>
            <div class="nav-item">
                <a asp-controller="Pos" asp-action="Wastage"
                   class="@(controller == "Pos" && action == "Wastage" ? "active" : "")">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Wastage
                </a>
            </div>

            <div class="nav-section-title">ออเดอร์</div>
            <div class="nav-item">
                <a asp-controller="Admin" asp-action="Orders"
                   class="@(controller == "Admin" && action == "Orders" ? "active" : "")">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                    </svg>
                    รายการออเดอร์
                </a>
            </div>
            <div class="nav-item">
                <a asp-controller="Admin" asp-action="Payments"
                   class="@(controller == "Admin" && action == "Payments" ? "active" : "")">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                    </svg>
                    ตรวจสอบสลิป
                    @if (ViewBag.PendingPaymentCount is int pending && pending > 0)
                    {
                        <span class="nav-badge">@pending</span>
                    }
                </a>
            </div>

            @if (roleId is 3 or 5)
            {
                <div class="nav-section-title">จัดการเมนู</div>
                <div class="nav-item">
                    <a asp-controller="Admin" asp-action="MenuList"
                       class="@(controller == "Admin" && (action == "MenuList" || action == "MenuCreate" || action == "MenuEdit") ? "active" : "")">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                        รายการเมนู
                    </a>
                </div>

                <div class="nav-section-title">คลังวัตถุดิบ</div>
                <div class="nav-item">
                    <a asp-controller="Admin" asp-action="Inventory"
                       class="@(controller == "Admin" && action == "Inventory" ? "active" : "")">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                        สต็อก / Restock
                    </a>
                </div>
                <div class="nav-item">
                    <a asp-controller="Admin" asp-action="Recipes"
                       class="@(controller == "Admin" && action == "Recipes" ? "active" : "")">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                        </svg>
                        สูตรวัตถุดิบ
                    </a>
                </div>

            }

            @if (roleId is 3 or 4 or 5)
            {
                <div class="nav-section-title">รายงาน / การเงิน</div>
                <div class="nav-item">
                    <a asp-controller="Admin" asp-action="Reports"
                       class="@(controller == "Admin" && action == "Reports" ? "active" : "")">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        ยอดขาย
                    </a>
                </div>
                <div class="nav-item">
                    <a asp-controller="Admin" asp-action="Finance"
                       class="@(controller == "Admin" && action == "Finance" ? "active" : "")">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Finance
                    </a>
                </div>
            }

            @if (roleId is 3 or 5)
            {
                <div class="nav-section-title">โต๊ะ / QR Code</div>
                <div class="nav-item">
                    <a asp-controller="Admin" asp-action="Tables"
                       class="@(controller == "Admin" && (action == "Tables" || action == "QrPrint") ? "active" : "")">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                        </svg>
                        จัดการโต๊ะ / QR
                    </a>
                </div>
            }

            @if (roleId is 3 or 5)
            {
                <div class="nav-section-title">โปรโมชั่น</div>
                <div class="nav-item">
                    <a asp-controller="Admin" asp-action="Promotions"
                       class="@(controller == "Admin" && action == "Promotions" ? "active" : "")">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                        </svg>
                        โปรโมชั่น
                    </a>
                </div>
            }

            @* Shifts — ซ่อนชั่วคราว ยังไม่พร้อมใช้งาน *@

            <!-- Public Screen — เปิดแท็บใหม่ ไม่ต้อง Login -->
            <div class="nav-section-title">จอแสดงผล</div>
            <div class="nav-item">
                <a href="/Public/Queue" target="_blank">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    Public Screen (TV)
                </a>
            </div>

            @if (roleId is 3 or 5)
            {
                <div class="nav-section-title">สมาชิก / พนักงาน</div>
                <div class="nav-item">
                    <a asp-controller="Account" asp-action="MemberList">
                        <!-- Heroicons outline: users (ครบ 2 path) -->
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                        รายชื่อสมาชิก
                    </a>
                </div>
                <div class="nav-item">
                    <a asp-controller="Account" asp-action="AddStaff">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                        </svg>
                        เพิ่มพนักงาน
                    </a>
                </div>
            }
        </nav>

        <div class="sidebar-footer">
            @{
                var fullName = Context.Session.GetString("FullName");
                var roleNames = new Dictionary<int, string>
                {
                    {1, "Barista"}, {2, "Cashier"}, {3, "Store Manager"},
                    {4, "Finance"}, {5, "Owner"}
                };
                var roleName = roleId.HasValue ? roleNames.GetValueOrDefault(roleId.Value, "Staff") : "—";
            }
            <div class="staff-name">@(fullName ?? "—")</div>
            <div class="staff-role">@roleName</div>
            <a asp-controller="Account" asp-action="Logout">ออกจากระบบ</a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="admin-main">
        <!-- Topbar -->
        <div class="admin-topbar">
            <div class="page-title-bar">@(ViewData["Title"] ?? "Admin")</div>
            <div style="font-size:0.8rem; color:#6b7280;">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
        </div>

        <!-- Flash Messages -->
        <div class="admin-content">
            @if (TempData["Success"] != null)
            {
                <div class="flash-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="flash-error">@TempData["Error"]</div>
            }

            @RenderBody()
        </div>
    </div>

</body>

<!-- SignalR Client — พนักงาน Join กลุ่ม "staff" เพื่อรับ NotifyNewSlip -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
(function () {
    var connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/cafe")
        .withAutomaticReconnect()
        .build();

    // รับแจ้งเตือนสลิปใหม่ — แสดง toast และอัปเดต badge
    connection.on("NotifyNewSlip", function (data) {
        showToast("มีสลิปใหม่รอตรวจสอบ — ออเดอร์ #" + data.orderId + " (" + data.amount + "฿)", "warning");
        // อัปเดต badge ตรวจสอบสลิปใน Sidebar
        var badge = document.querySelector('.nav-badge');
        if (badge) {
            badge.textContent = parseInt(badge.textContent || "0") + 1;
        }
    });

    connection.start()
        .then(function () { return connection.invoke("JoinGroup", "staff"); })
        .catch(function (err) { console.error("SignalR Admin connect error:", err); });

    // Toast notification ง่ายๆ
    function showToast(msg, type) {
        var toast = document.createElement('div');
        toast.textContent = msg;
        toast.style.cssText = [
            "position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;",
            "padding:0.75rem 1.25rem;border-radius:10px;font-size:0.875rem;font-weight:700;",
            "box-shadow:0 4px 16px rgba(0,0,0,0.15);animation:fadeIn 0.3s ease;",
            type === "warning"
                ? "background:#fef3c7;color:#92400e;border:1.5px solid #fde68a;"
                : "background:#d1fae5;color:#065f46;border:1.5px solid #6ee7b7;"
        ].join('');
        document.body.appendChild(toast);
        setTimeout(function () { toast.remove(); }, 5000);
    }
})();
</script>

</html>
