<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <meta name="theme-color" content="#3E2723" />
    <title>@ViewData["Title"] — Smart Cafe</title>

    <link rel="icon" href="/coffee-removebg-preview.ico" type="image/x-icon" />

    <!-- PWA Manifest placeholder -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&family=Playfair+Display:wght@700&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <!-- DaisyUI + Tailwind -->
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.14/dist/full.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        /* ===== CSS Variables ===== */
        :root {
            --cf-dark:    #3E2723;
            --cf-primary: #6F4E37;
            --cf-medium:  #8D6748;
            --cf-latte:   #C8A97E;
            --cf-cream:   #EFE0C9;
            --cf-foam:    #FDF6EC;
            /* บังคับ browser ไม่ให้ใช้ auto dark mode กับหน้านี้ */
            color-scheme: light;
        }

        * { box-sizing: border-box; }

        html {
            background-color: var(--cf-foam);
        }

        body {
            font-family: 'Sarabun', sans-serif;
            background-color: var(--cf-foam);
            color: var(--cf-dark);
            min-height: 100dvh;
            /* เว้นที่ให้ Bottom Nav */
            padding-bottom: 70px;
        }

        /* ===== Mobile Header ===== */
        .mobile-header {
            position: sticky;
            top: 0;
            z-index: 50;
            background-color: var(--cf-dark);
            color: #fff;
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        .mobile-header .brand {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            color: var(--cf-latte);
        }
        .mobile-header .cart-btn {
            position: relative;
            background: rgba(255,255,255,0.12);
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            cursor: pointer;
            text-decoration: none;
        }
        .mobile-header .cart-btn:active { background: rgba(255,255,255,0.22); }
        .cart-badge {
            position: absolute;
            top: -3px;
            right: -3px;
            background: #ef4444;
            color: #fff;
            border-radius: 50%;
            min-width: 18px;
            height: 18px;
            font-size: 0.65rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 3px;
        }

        /* ===== Bottom Navigation ===== */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 50;
            background-color: var(--cf-dark);
            border-top: 2px solid var(--cf-latte);
            display: flex;
            justify-content: space-around;
            padding: 0.4rem 0 0.6rem;
        }
        .bottom-nav a {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            color: rgba(255,255,255,0.55);
            font-size: 0.6rem;
            text-decoration: none;
            font-weight: 600;
            letter-spacing: 0.03em;
            padding: 0.3rem 0.6rem;
            border-radius: 8px;
            transition: color 0.2s;
        }
        .bottom-nav a.active,
        .bottom-nav a:hover { color: var(--cf-latte); }
        .bottom-nav svg { width: 22px; height: 22px; }

        /* ===== Flash Messages ===== */
        .flash-success {
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #6ee7b7;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin: 0.75rem 1rem;
            font-size: 0.875rem;
        }
        .flash-error {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin: 0.75rem 1rem;
            font-size: 0.875rem;
        }

        /* ===== Product Card ===== */
        .product-card {
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(111,78,55,0.10);
            border: 1px solid var(--cf-cream);
            cursor: pointer;
            transition: transform 0.18s, box-shadow 0.18s;
            position: relative;
        }
        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(111,78,55,0.18);
        }
        .product-card img {
            width: 100%;
            aspect-ratio: 4/3;
            object-fit: cover;
        }
        .product-card .card-body {
            padding: 0.75rem;
        }
        .product-card .menu-name {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--cf-dark);
            line-height: 1.3;
        }
        .product-card .menu-price {
            font-family: 'Inter', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            color: var(--cf-primary);
            margin-top: 0.25rem;
        }
        .product-card .badge-sold-out {
            background-color: #fee2e2;
            color: #991b1b;
            font-size: 0.65rem;
            padding: 0.15rem 0.45rem;
            border-radius: 4px;
            font-weight: 700;
        }

        /* ===== Category Filter ===== */
        .category-filter {
            display: flex;
            gap: 0.5rem;
            overflow-x: auto;
            padding: 0.75rem 1rem;
            scrollbar-width: none;
        }
        .category-filter::-webkit-scrollbar { display: none; }
        .cat-btn {
            flex-shrink: 0;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            border: 1.5px solid var(--cf-latte);
            background: transparent;
            color: var(--cf-primary);
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            text-decoration: none;
            transition: background 0.18s, color 0.18s;
        }
        .cat-btn.active,
        .cat-btn:hover {
            background: var(--cf-primary);
            color: #fff;
            border-color: var(--cf-primary);
        }

        /* ===== Order Status Steps ===== */
        .status-steps {
            display: flex;
            justify-content: space-between;
            position: relative;
            margin: 1.5rem 0;
        }
        .status-steps::before {
            content: '';
            position: absolute;
            top: 18px;
            left: 10%;
            right: 10%;
            height: 3px;
            background-color: var(--cf-cream);
        }
        .status-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            z-index: 1;
        }
        .status-step .dot {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--cf-cream);
            border: 3px solid #fff;
            box-shadow: 0 0 0 2px var(--cf-cream);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .status-step.done .dot {
            background: var(--cf-primary);
            box-shadow: 0 0 0 2px var(--cf-primary);
        }
        .status-step.active .dot {
            background: var(--cf-latte);
            box-shadow: 0 0 0 2px var(--cf-latte);
            animation: pulse 1.5s ease-in-out infinite;
        }
        @@keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 2px var(--cf-latte); }
            50% { box-shadow: 0 0 0 6px rgba(200,169,126,0.3); }
        }
        .status-step .label {
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--cf-medium);
            text-align: center;
            max-width: 55px;
            line-height: 1.2;
        }
        .status-step.done .label,
        .status-step.active .label { color: var(--cf-primary); }

        /* ===== Notification System ===== */
        .notif-bell-btn {
            position: relative;
            background: rgba(255,255,255,0.12);
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            cursor: pointer;
            flex-shrink: 0;
        }
        .notif-bell-btn:active { background: rgba(255,255,255,0.22); }
        .notif-badge {
            position: absolute;
            top: -3px;
            right: -3px;
            background: #ef4444;
            color: #fff;
            border-radius: 50%;
            min-width: 18px;
            height: 18px;
            font-size: 0.65rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 3px;
        }
        #notif-drawer {
            transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
        }
        #order-ready-overlay {
            transition: opacity 0.3s;
        }
        @@keyframes ready-pulse {
            0%, 100% { transform: scale(1); opacity: 0.3; }
            50% { transform: scale(1.15); opacity: 0.1; }
        }
        .ready-ring {
            animation: ready-pulse 1.5s ease-in-out infinite;
        }

    </style>
</head>
<body>

    <!-- Header -->
    <header class="mobile-header">
        <div>
            <div class="brand">Smart Cafe</div>
            @{
                var tableNum = Context.Session.GetString("TableNumber");
            }
            @if (!string.IsNullOrEmpty(tableNum))
            {
                <div class="text-[0.7rem] text-white/55 mt-px">โต๊ะ @tableNum</div>
            }
        </div>

        <div class="flex items-center gap-2">
            @{
                var memberPhoneForTable = Context.Session.GetString($"MemberPhone_{tableNum ?? "default"}");
                bool isLoggedIn = !string.IsNullOrEmpty(memberPhoneForTable);
            }

            <!-- Profile Dropdown — แสดงเสมอ สถานะเปลี่ยนตาม Login -->
            <div class="relative" id="profileDropdownWrapper">
                <button id="profileDropdownBtn"
                        onclick="toggleProfileDropdown(event)"
                        aria-label="เมนูโปรไฟล์"
                        class="flex items-center justify-center rounded-full w-10 h-10 flex-shrink-0 border @(isLoggedIn ? "bg-amber-400/20 border-amber-400/50 text-amber-300" : "bg-white/10 border-white/25 text-white/70")">
                    @if (isLoggedIn)
                    {
                        <!-- ไอคอน User มี checkmark เล็ก ๆ แสดงว่า Login อยู่ -->
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    }
                    else
                    {
                        <!-- ไอคอน User ธรรมดา — ยังไม่ได้ Login -->
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    }
                </button>

                <!-- Dropdown Panel -->
                <div id="profileDropdownPanel"
                     class="hidden absolute right-0 top-[calc(100%+8px)] z-[100] w-52 rounded-2xl overflow-hidden shadow-2xl"
                     style="background:#2C1A0E;border:1px solid rgba(200,169,126,0.25);">

                    @if (isLoggedIn)
                    {
                        <!-- Header: ชื่อ/เบอร์สมาชิก -->
                        <div class="px-4 py-3 border-b" style="border-color:rgba(200,169,126,0.15);">
                            <div class="text-[0.62rem] text-amber-400/60 uppercase tracking-widest mb-0.5">สมาชิก</div>
                            <div class="text-white font-bold text-[0.82rem] truncate">@memberPhoneForTable</div>
                        </div>

                        <!-- เมนูแก้ไขโปรไฟล์ -->
                        <a href="/Customer/EditProfile"
                           class="flex items-center gap-3 px-4 py-3 text-white/85 hover:bg-white/8 no-underline transition-colors"
                           style="font-size:0.82rem;">
                            <span class="flex items-center justify-center w-7 h-7 rounded-lg flex-shrink-0"
                                  style="background:rgba(200,169,126,0.15);">
                                <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                            </span>
                            <span class="font-semibold">แก้ไขข้อมูลสมาชิก</span>
                        </a>

                        <!-- Stamp Card -->
                        <a href="/Customer/Rewards"
                           class="flex items-center gap-3 px-4 py-3 text-white/85 hover:bg-white/8 no-underline transition-colors"
                           style="font-size:0.82rem;">
                            <span class="flex items-center justify-center w-7 h-7 rounded-lg flex-shrink-0"
                                  style="background:rgba(200,169,126,0.15);">
                                <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                                </svg>
                            </span>
                            <span class="font-semibold">Stamp Card &amp; รางวัล</span>
                        </a>

                        <!-- Divider -->
                        <div class="mx-4 my-1" style="height:1px;background:rgba(200,169,126,0.12);"></div>

                        <!-- Logout — ผ่าน requestLogout() เพื่อตรวจ active order ก่อน -->
                        <button type="button" onclick="closeProfileDropdown();requestLogout();"
                                class="flex items-center gap-3 px-4 py-3 w-full text-left border-none bg-transparent cursor-pointer transition-colors"
                                style="font-size:0.82rem;color:rgba(252,165,165,0.85);">
                            <span class="flex items-center justify-center w-7 h-7 rounded-lg flex-shrink-0"
                                  style="background:rgba(239,68,68,0.12);">
                                <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                </svg>
                            </span>
                            <span class="font-semibold">ออกจากระบบ</span>
                        </button>
                    }
                    else
                    {
                        <!-- Header: Guest -->
                        <div class="px-4 py-3 border-b" style="border-color:rgba(200,169,126,0.15);">
                            <div class="text-[0.62rem] text-white/40 uppercase tracking-widest mb-0.5">สถานะ</div>
                            <div class="text-white/70 font-semibold text-[0.82rem]">ลูกค้าทั่วไป</div>
                        </div>

                        <!-- สมัครสมาชิก -->
                        <a href="/Customer/RegisterMobile@(!string.IsNullOrEmpty(tableNum) ? $"?table={tableNum}" : "")"
                           class="flex items-center gap-3 px-4 py-3 text-white/85 hover:bg-white/8 no-underline transition-colors"
                           style="font-size:0.82rem;">
                            <span class="flex items-center justify-center w-7 h-7 rounded-lg flex-shrink-0"
                                  style="background:rgba(200,169,126,0.15);">
                                <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                                </svg>
                            </span>
                            <div>
                                <div class="font-bold text-amber-300" style="font-size:0.82rem;">สมัครสมาชิก</div>
                                <div class="text-white/40 leading-tight" style="font-size:0.65rem;">สะสมแต้ม · Stamp Card · โปรวันเกิด</div>
                            </div>
                        </a>

                        <!-- วิธีรับสิทธิ์ -->
                        <div class="px-4 py-3" style="border-top:1px solid rgba(200,169,126,0.1);">
                            <div class="text-[0.68rem] text-white/35 leading-relaxed">
                                ใส่เบอร์สมาชิกตอนสั่งซื้อเพื่อรับแต้มสะสม
                            </div>
                        </div>
                    }

                    <!-- ปิด -->
                    <div class="px-4 pb-3 pt-1">
                        <button onclick="closeProfileDropdown()"
                                class="w-full text-[0.72rem] text-white/30 border-none bg-transparent cursor-pointer py-1">
                            ปิด
                        </button>
                    </div>

                </div>
            </div>

            <!-- ปุ่มแจ้งเตือน -->
            <button id="notif-bell-btn" class="notif-bell-btn" onclick="openNotifDrawer()" aria-label="การแจ้งเตือน">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                </svg>
                <span id="notif-badge" class="notif-badge hidden">0</span>
            </button>

            <!-- ปุ่มตะกร้า -->
            <a asp-controller="Customer" asp-action="Cart" class="cart-btn">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M9 21a1 1 0 110-2 1 1 0 010 2zm8 0a1 1 0 110-2 1 1 0 010 2z"/>
                </svg>
                @{
                    var cartCount = ViewBag.CartCount as int? ?? 0;
                }
                @if (cartCount > 0)
                {
                    <span class="cart-badge">@cartCount</span>
                }
            </a>
        </div>
    </header>

    <script>
        // Profile Dropdown — toggle เปิด/ปิด, ปิดเมื่อกดนอก panel
        function toggleProfileDropdown(e) {
            e.stopPropagation();
            var panel = document.getElementById('profileDropdownPanel');
            panel.classList.toggle('hidden');
        }
        function closeProfileDropdown() {
            document.getElementById('profileDropdownPanel').classList.add('hidden');
        }
        document.addEventListener('click', function (e) {
            var wrapper = document.getElementById('profileDropdownWrapper');
            if (wrapper && !wrapper.contains(e.target)) {
                closeProfileDropdown();
            }
        });
    </script>

    <!-- Flash Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="flash-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flash-error">@TempData["Error"]</div>
    }

    <!-- แบนเนอร์ออเดอร์ที่กำลังดำเนินการอยู่ -->
    @{
        var activeOrderId = ViewBag.ActiveOrderId as int?;
    }
    @if (activeOrderId.HasValue)
    {
        <a href="@Url.Action("Tracking", "Customer", new { orderId = activeOrderId })"
           class="flex items-center gap-2.5 mx-4 my-2 bg-amber-100 border-[1.5px] border-amber-300 rounded-xl px-3.5 py-2.5 no-underline">
            <span class="w-2 h-2 rounded-full bg-amber-500 flex-shrink-0 animate-pulse"></span>
            <div class="flex-1 min-w-0">
                <div class="text-[0.82rem] font-bold text-amber-800">มีออเดอร์ที่กำลังดำเนินการ</div>
                <div class="text-[0.7rem] text-amber-700 mt-px">แตะเพื่อติดตามสถานะออเดอร์ #@activeOrderId</div>
            </div>
            <!-- Chevron right icon — Heroicons outline -->
            <svg class="w-4 h-4 text-amber-700 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
        </a>
    }

    <!-- เนื้อหาหลัก -->
    <main>
        @RenderBody()
    </main>

    <!-- Bottom Navigation -->
    <nav class="bottom-nav">
        <a asp-controller="Customer" asp-action="Menu"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Menu" ? "active" : "")">
            <!-- Home Icon -->
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            เมนู
        </a>
        <a asp-controller="Customer" asp-action="Rewards"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Rewards" ? "active" : "")">
            <!-- Star icon — Heroicons outline -->
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
            รางวัล
        </a>
        <a asp-controller="Customer" asp-action="MyOrders"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() is "MyOrders" or "Tracking" ? "active" : "")">
            <!-- Clipboard list icon — Heroicons outline -->
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
            ออเดอร์
        </a>
        <!-- คิวออเดอร์ — แสดงลำดับคิวทั้งหมดของร้าน -->
        <a asp-controller="Customer" asp-action="OrderQueue"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "OrderQueue" ? "active" : "")">
            <!-- Queue / List Bullet icon — Heroicons outline -->
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
            </svg>
            คิวออเดอร์
        </a>
    </nav>

    <!-- ============================================================
         Notification Drawer (Bottom Sheet)
         ============================================================ -->

    <!-- Backdrop -->
    <div id="notif-backdrop"
         class="fixed inset-0 bg-black/50 z-[200] hidden"
         onclick="closeNotifDrawer()"></div>

    <!-- Drawer -->
    <div id="notif-drawer"
         class="fixed bottom-0 left-0 right-0 z-[201] bg-white rounded-t-2xl translate-y-full shadow-2xl flex flex-col"
         style="max-height:80vh;">

        <!-- Drag handle -->
        <div class="flex justify-center pt-3 pb-1 flex-shrink-0">
            <div class="w-10 h-1 rounded-full bg-gray-200"></div>
        </div>

        <!-- Drawer header -->
        <div class="flex justify-between items-center px-4 py-3 border-b border-gray-100 flex-shrink-0">
            <h3 class="font-bold text-base text-[#3E2723]">การแจ้งเตือน</h3>
            <button onclick="closeNotifDrawer()"
                    class="w-8 h-8 flex items-center justify-center rounded-full text-gray-400">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- รายการแจ้งเตือน (JavaScript จะสร้างเนื้อหา) -->
        <div id="notif-list" class="overflow-y-auto flex-1 pb-8"></div>
    </div>

    <!-- ============================================================
         Order Ready Overlay (Full Screen)
         ============================================================ -->
    <div id="order-ready-overlay"
         class="fixed inset-0 z-[300] hidden flex-col items-center justify-center px-6"
         style="background:linear-gradient(135deg,#6F4E37,#3E2723);">

        <!-- Pulse rings -->
        <div class="relative flex items-center justify-center mb-8">
            <div class="absolute w-36 h-36 rounded-full ready-ring"
                 style="background:rgba(200,169,126,0.25);"></div>
            <div class="absolute w-28 h-28 rounded-full"
                 style="background:rgba(200,169,126,0.18);"></div>
            <!-- Checkmark circle -->
            <div class="relative z-10 w-20 h-20 rounded-full flex items-center justify-center"
                 style="background:#C8A97E;">
                <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
        </div>

        <!-- ข้อความ -->
        <div class="text-center text-white">
            <div class="text-base opacity-75 font-medium mb-1">เครื่องดื่มของคุณพร้อมแล้ว</div>
            <div class="text-sm opacity-60 mb-3">คิวหมายเลข</div>
            <div id="overlay-queue-number"
                 class="font-serif font-bold leading-none tracking-wider"
                 style="font-size:5.5rem;">A001</div>
            <div class="text-base opacity-80 mt-5">กรุณามารับที่เคาน์เตอร์</div>
        </div>

        <!-- ปุ่ม dismiss -->
        <button onclick="closeOrderReadyOverlay()"
                class="mt-10 px-10 py-3.5 rounded-2xl font-bold text-base text-white"
                style="background:rgba(255,255,255,0.18);border:2px solid rgba(255,255,255,0.5);">
            รับทราบ
        </button>
    </div>

</body>

<!-- SignalR Client — ลูกค้า Join กลุ่ม "order-{orderId}" เพื่อรับ NotifyOrderPaid, NotifySlipRejected, NotifyOrderReady -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
(function () {
    // ============================================================
    // ระบบแจ้งเตือนฝั่งลูกค้า — SignalR + localStorage
    // ============================================================

    var NOTIF_KEY      = 'cafeNotifs';
    var NOTIF_DATE_KEY = 'cafeNotifsDate';
    var ORDER_ID_KEY   = 'cafeOrderIds';
    var MAX_NOTIFS     = 20;

    // ---- Helpers ----

    function getNotifs() {
        try { return JSON.parse(localStorage.getItem(NOTIF_KEY) || '[]'); }
        catch (e) { return []; }
    }

    function saveNotifs(list) {
        try { localStorage.setItem(NOTIF_KEY, JSON.stringify(list.slice(0, MAX_NOTIFS))); }
        catch (e) {}
    }

    function addNotif(type, title, body) {
        var list = getNotifs();
        list.unshift({ id: Date.now(), type: type, title: title, body: body, read: false, ts: Date.now() });
        saveNotifs(list);
        updateBellBadge();
    }

    function getUnreadCount() {
        return getNotifs().filter(function (n) { return !n.read; }).length;
    }

    function markAllRead() {
        var list = getNotifs().map(function (n) { return Object.assign({}, n, { read: true }); });
        saveNotifs(list);
        updateBellBadge();
    }

    function updateBellBadge() {
        var count = getUnreadCount();
        var badge = document.getElementById('notif-badge');
        if (!badge) return;
        if (count > 0) {
            badge.textContent = count > 9 ? '9+' : String(count);
            badge.classList.remove('hidden');
        } else {
            badge.classList.add('hidden');
        }
    }

    // ตรวจสอบวันที่ — ถ้าขึ้นวันใหม่ให้ล้างรายการแจ้งเตือนทั้งหมด
    // ล้างเฉพาะ NOTIF_KEY เท่านั้น ไม่กระทบ ORDER_ID_KEY (ออเดอร์ที่ยังค้างอยู่)
    function resetNotifsIfNewDay() {
        var today = new Date().toISOString().slice(0, 10); // "YYYY-MM-DD"
        try {
            var lastDate = localStorage.getItem(NOTIF_DATE_KEY);
            if (lastDate !== today) {
                localStorage.removeItem(NOTIF_KEY);
                localStorage.setItem(NOTIF_DATE_KEY, today);
            }
        } catch (e) {}
    }

    function escapeHtml(str) {
        var d = document.createElement('div');
        d.textContent = str || '';
        return d.innerHTML;
    }

    function formatTime(ts) {
        var diffMin = Math.floor((Date.now() - ts) / 60000);
        if (diffMin < 1)  return 'เมื่อกี้';
        if (diffMin < 60) return diffMin + ' นาทีที่แล้ว';
        var diffHr = Math.floor(diffMin / 60);
        if (diffHr < 24)  return diffHr + ' ชั่วโมงที่แล้ว';
        return new Date(ts).toLocaleDateString('th-TH', { day: 'numeric', month: 'short' });
    }

    // ---- Notification Drawer ----

    window.openNotifDrawer = function () {
        renderNotifList();
        var backdrop = document.getElementById('notif-backdrop');
        var drawer   = document.getElementById('notif-drawer');
        if (!backdrop || !drawer) return;
        backdrop.classList.remove('hidden');
        drawer.offsetHeight; // force reflow ก่อน transition
        drawer.classList.remove('translate-y-full');
        markAllRead();
    };

    window.closeNotifDrawer = function () {
        var backdrop = document.getElementById('notif-backdrop');
        var drawer   = document.getElementById('notif-drawer');
        if (!backdrop || !drawer) return;
        drawer.classList.add('translate-y-full');
        setTimeout(function () { backdrop.classList.add('hidden'); }, 320);
    };

    function renderNotifList() {
        var list      = getNotifs();
        var container = document.getElementById('notif-list');
        if (!container) return;

        if (list.length === 0) {
            container.innerHTML =
                '<div class="p-10 text-center">' +
                '<div class="text-gray-300 mb-2">' +
                '<svg class="w-12 h-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">' +
                '<path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>' +
                '</svg></div>' +
                '<div class="text-gray-400 text-sm">ยังไม่มีการแจ้งเตือน</div>' +
                '</div>';
            return;
        }

        // สร้าง icon ตามประเภท
        function makeIcon(type) {
            if (type === 'ready') {
                return '<div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">' +
                    '<svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>' +
                    '</div>';
            }
            if (type === 'paid') {
                return '<div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0">' +
                    '<svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>' +
                    '</div>';
            }
            // rejected
            return '<div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">' +
                '<svg class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>' +
                '</div>';
        }

        container.innerHTML = list.map(function (n) {
            var rowBg     = n.read ? '' : 'background:rgba(239,230,214,0.35);';
            var unreadDot = n.read
                ? '<span class="w-2 h-2 flex-shrink-0"></span>'
                : '<span class="w-2 h-2 rounded-full flex-shrink-0 mt-1.5" style="background:#6F4E37;"></span>';

            return '<div class="flex items-start gap-3 px-4 py-3.5 border-b border-gray-50" style="' + rowBg + '">' +
                makeIcon(n.type) +
                '<div class="flex-1 min-w-0">' +
                '<div class="font-bold text-sm text-[#3E2723]">' + escapeHtml(n.title) + '</div>' +
                '<div class="text-[0.8rem] text-gray-500 mt-0.5 leading-relaxed">' + escapeHtml(n.body) + '</div>' +
                '<div class="text-[0.7rem] text-gray-400 mt-1">' + formatTime(n.ts) + '</div>' +
                '</div>' +
                unreadDot +
                '</div>';
        }).join('');
    }

    // ---- Order Ready Overlay ----

    window.closeOrderReadyOverlay = function () {
        var overlay = document.getElementById('order-ready-overlay');
        if (!overlay) return;
        overlay.style.opacity = '0';
        setTimeout(function () {
            overlay.classList.add('hidden');
            overlay.classList.remove('flex');
            overlay.style.opacity = '';
        }, 300);
    };

    function showOrderReadyOverlay(queueNumber) {
        var overlay = document.getElementById('order-ready-overlay');
        var qEl     = document.getElementById('overlay-queue-number');
        if (!overlay) return;
        if (qEl) qEl.textContent = queueNumber || '—';
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        // สั่นโทรศัพท์ถ้า browser รองรับ
        if (navigator.vibrate) navigator.vibrate([300, 100, 300]);
    }

    // ---- Notification Banner (แสดงข้อความสำคัญเหนือ Header) ----

    function showNotifBanner(type, title, body, action) {
        var existing = document.getElementById('notif-banner');
        if (existing) existing.remove();

        var isSuccess = type === 'success';
        var bg        = isSuccess ? '#d1fae5' : '#fee2e2';
        var border    = isSuccess ? '#6ee7b7' : '#fca5a5';
        var color     = isSuccess ? '#065f46' : '#991b1b';
        var btnBg     = isSuccess ? '#065f46' : '#991b1b';

        var actionHtml = action
            ? '<a href="' + action.url + '" style="display:inline-block;margin-top:0.5rem;padding:0.35rem 0.9rem;background:' + btnBg + ';color:#fff;border-radius:8px;font-size:0.78rem;font-weight:700;text-decoration:none;">' + escapeHtml(action.label) + '</a>'
            : '';

        var banner = document.createElement('div');
        banner.id = 'notif-banner';
        banner.style.cssText = 'position:fixed;top:68px;left:0.75rem;right:0.75rem;z-index:9990;padding:0.85rem 1rem;border-radius:14px;border:1.5px solid ' + border + ';box-shadow:0 6px 24px rgba(0,0,0,0.14);background:' + bg + ';color:' + color + ';';
        banner.innerHTML =
            '<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.5rem;">' +
            '<div style="flex:1;">' +
            '<div style="font-weight:700;font-size:0.9rem;">' + escapeHtml(title) + '</div>' +
            '<div style="font-size:0.8rem;margin-top:0.2rem;opacity:0.85;">' + escapeHtml(body) + '</div>' +
            actionHtml +
            '</div>' +
            '<button onclick="document.getElementById(\'notif-banner\').remove()" style="background:none;border:none;font-size:1.3rem;line-height:1;cursor:pointer;opacity:0.55;padding:0;color:inherit;flex-shrink:0;">&times;</button>' +
            '</div>';

        document.body.appendChild(banner);

        // success หายเองใน 6 วินาที / error ต้อง dismiss เอง
        if (isSuccess) {
            setTimeout(function () { if (banner.parentNode) banner.remove(); }, 6000);
        }
    }

    // ---- SignalR — รวบรวม orderId จากหลายแหล่ง ----

    var orderIds = [];

    function addOrderId(id) {
        id = parseInt(id, 10);
        if (!id || isNaN(id)) return;
        if (orderIds.indexOf(id) === -1) orderIds.push(id);
    }

    // แหล่ง 1: meta tag ที่ Tracking.cshtml ฝังไว้
    var metaEl = document.querySelector('meta[name="current-order-id"]');
    if (metaEl) addOrderId(metaEl.getAttribute('content'));

    // แหล่ง 2: ViewBag.ActiveOrderId ที่ Layout ฝังไว้ (active order banner)
    var activeId = @((int?)(ViewBag.ActiveOrderId) ?? 0);
    if (activeId) addOrderId(activeId);

    // แหล่ง 3: localStorage (ออเดอร์ก่อนหน้าที่อาจยังไม่เสร็จ)
    try {
        var stored = JSON.parse(localStorage.getItem(ORDER_ID_KEY) || '[]');
        stored.forEach(function (id) { addOrderId(id); });
    } catch (e) {}

    // บันทึก orderIds ล่าสุดลง localStorage (เก็บไว้ข้ามหน้า)
    if (orderIds.length > 0) {
        try { localStorage.setItem(ORDER_ID_KEY, JSON.stringify(orderIds.slice(0, 5))); }
        catch (e) {}
    }

    // reset แจ้งเตือนเมื่อขึ้นวันใหม่ ก่อนอัปเดต badge
    resetNotifsIfNewDay();
    updateBellBadge();

    // ถ้าไม่มีออเดอร์ให้ติดตาม ไม่ต้องเชื่อม SignalR
    if (orderIds.length === 0) return;

    var connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/cafe")
        .withAutomaticReconnect()
        .build();

    // ชำระเงินสำเร็จ (สลิป Approved)
    connection.on("NotifyOrderPaid", function (data) {
        if (orderIds.indexOf(data.orderId) === -1) return;
        var title = "ชำระเงินสำเร็จ";
        var body  = "คิวหมายเลข " + (data.queueNumber || '—') + " กำลังเตรียมออเดอร์ของคุณ";
        addNotif('paid', title, body);
        showNotifBanner('success', title, body);
        setTimeout(function () { location.reload(); }, 2500);
    });

    // สลิปถูกปฏิเสธ
    connection.on("NotifySlipRejected", function (data) {
        if (orderIds.indexOf(data.orderId) === -1) return;
        var title  = "สลิปถูกปฏิเสธ";
        var reason = data.reason ? ' (' + data.reason + ')' : '';
        var body   = "กรุณาอัปโหลดสลิปใหม่" + reason;
        addNotif('rejected', title, body);
        showNotifBanner('error', title, body, {
            url:   '/Customer/Payment?orderId=' + data.orderId,
            label: 'อัปโหลดสลิปใหม่'
        });
        // reload ช้าลงเพื่อให้ลูกค้าอ่านเหตุผลก่อน
        setTimeout(function () { location.reload(); }, 4000);
    });

    // ออเดอร์พร้อมรับ → แสดง overlay + เริ่ม auto-logout countdown
    connection.on("NotifyOrderReady", function (data) {
        if (orderIds.indexOf(data.orderId) === -1) return;
        var title = "ออเดอร์พร้อมแล้ว!";
        var body  = "คิว " + (data.queueNumber || '—') + " กรุณามารับที่เคาน์เตอร์";
        addNotif('ready', title, body);
        showOrderReadyOverlay(data.queueNumber);
        // ลบออเดอร์นี้ออกจาก localStorage เพราะเสร็จแล้ว
        try {
            var remaining = JSON.parse(localStorage.getItem(ORDER_ID_KEY) || '[]')
                .filter(function (id) { return id !== data.orderId; });
            localStorage.setItem(ORDER_ID_KEY, JSON.stringify(remaining));
        } catch (e) {}
        // เริ่ม auto-logout countdown 5 นาทีทุกหน้า (ไม่ใช่แค่ Tracking)
        startAutoLogoutCountdown(5 * 60);
    });

    // Group Check-in อนุมัติแล้ว → แสดง banner + reload หน้าชำระเงิน
    connection.on("NotifyGroupCheckinApproved", function (data) {
        if (orderIds.indexOf(data.orderId) === -1) return;
        var discStr = Number(data.discount).toLocaleString('th-TH', { maximumFractionDigits: 0 });
        var netStr  = Number(data.newNetAmount).toLocaleString('th-TH', { maximumFractionDigits: 0 });
        var title = "ได้รับส่วนลด Group Check-in!";
        var body  = "ลด " + discStr + "฿ ยอดใหม่ " + netStr + "฿";
        addNotif('paid', title, body);
        showNotifBanner('success', title, body);
        setTimeout(function () { location.reload(); }, 2500);
    });

    // ออเดอร์ Completed — logout ทันที (ลูกค้ารับของแล้ว)
    connection.on("NotifyOrderCompleted", function (data) {
        if (orderIds.indexOf(data.orderId) === -1) return;
        try {
            var remaining = JSON.parse(localStorage.getItem(ORDER_ID_KEY) || '[]')
                .filter(function (id) { return id !== data.orderId; });
            localStorage.setItem(ORDER_ID_KEY, JSON.stringify(remaining));
        } catch (e) {}
        // logout ทันทีเมื่อ Completed
        window.location.href = '/Customer/MemberLogout?force=true';
    });

    // เชื่อมต่อและ join ทุก order group
    connection.start()
        .then(function () {
            orderIds.forEach(function (id) {
                connection.invoke("JoinGroup", "order-" + id)
                    .catch(function (e) { console.error("JoinGroup error:", e); });
            });
        })
        .catch(function (err) { console.error("SignalR Customer connect error:", err); });
})();

// ============================================================
// Auto-Logout Countdown — ทำงานนอก IIFE เพื่อให้เรียกได้จากทุกที่
// ============================================================
var _autoLogoutTimer   = null;
var _autoLogoutSeconds = 0;

function startAutoLogoutCountdown(seconds) {
    if (_autoLogoutTimer) clearInterval(_autoLogoutTimer);
    _autoLogoutSeconds = seconds;

    // สร้าง toast countdown ที่มุมล่างขวา
    var toast = document.getElementById('auto-logout-toast');
    if (!toast) {
        toast = document.createElement('div');
        toast.id = 'auto-logout-toast';
        toast.style.cssText =
            'position:fixed;bottom:80px;right:12px;z-index:9999;' +
            'background:#1C0F0A;border:1.5px solid rgba(200,169,126,0.35);' +
            'border-radius:14px;padding:0.75rem 1rem;min-width:180px;' +
            'box-shadow:0 4px 20px rgba(0,0,0,0.4);';
        toast.innerHTML =
            '<div style="font-size:0.65rem;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:2px;">ออกจากระบบอัตโนมัติใน</div>' +
            '<div id="auto-logout-display" style="font-family:\'Inter\',sans-serif;font-size:1.4rem;font-weight:700;color:#fbbf24;line-height:1;">5:00</div>' +
            '<div style="font-size:0.65rem;color:rgba(255,255,255,0.35);margin-top:2px;">เพื่อความปลอดภัยของบัญชีคุณ</div>' +
            '<button onclick="cancelAutoLogout()" style="margin-top:6px;width:100%;padding:0.3rem;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:8px;color:rgba(255,255,255,0.6);font-size:0.7rem;cursor:pointer;">ฉันยังอยู่ที่ร้าน — ยกเลิก</button>';
        document.body.appendChild(toast);
    }
    toast.style.display = 'block';

    _autoLogoutTimer = setInterval(function () {
        _autoLogoutSeconds--;
        var display = document.getElementById('auto-logout-display');
        if (display) {
            var m = Math.floor(_autoLogoutSeconds / 60);
            var s = _autoLogoutSeconds % 60;
            display.textContent = m + ':' + (s < 10 ? '0' : '') + s;
            // เปลี่ยนสีเป็นแดงเมื่อเหลือ < 1 นาที
            display.style.color = _autoLogoutSeconds <= 60 ? '#f87171' : '#fbbf24';
        }
        if (_autoLogoutSeconds <= 0) {
            clearInterval(_autoLogoutTimer);
            window.location.href = '/Customer/MemberLogout?force=true';
        }
    }, 1000);
}

function cancelAutoLogout() {
    if (_autoLogoutTimer) clearInterval(_autoLogoutTimer);
    var toast = document.getElementById('auto-logout-toast');
    if (toast) toast.style.display = 'none';
}

// ============================================================
// Logout with Active Order Warning — modal ยืนยันก่อน logout
// ============================================================
function requestLogout() {
    fetch('/Customer/MemberLogout', {
        method: 'GET',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.hasActiveOrder) {
            showLogoutWarningModal(data.orderId);
        } else {
            window.location.href = '/Customer/MemberLogout?force=true';
        }
    })
    .catch(function() {
        // fallback: logout ตรง
        window.location.href = '/Customer/MemberLogout?force=true';
    });
}

function showLogoutWarningModal(orderId) {
    var existing = document.getElementById('logout-warning-modal');
    if (existing) existing.remove();

    var modal = document.createElement('div');
    modal.id = 'logout-warning-modal';
    modal.style.cssText =
        'position:fixed;inset:0;z-index:10000;display:flex;align-items:flex-end;justify-content:center;' +
        'background:rgba(0,0,0,0.55);padding:0;';
    modal.innerHTML =
        '<div style="width:100%;max-width:480px;background:#fff;border-radius:20px 20px 0 0;padding:1.5rem 1.25rem 2rem;">' +
        '  <div style="width:40px;height:4px;border-radius:99px;background:#e5e7eb;margin:0 auto 1.25rem;"></div>' +
        '  <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;">' +
        '    <div style="width:44px;height:44px;border-radius:12px;background:#fef3c7;display:flex;align-items:center;justify-content:center;flex-shrink:0;">' +
        '      <svg style="width:22px;height:22px;color:#d97706;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>' +
        '    </div>' +
        '    <div>' +
        '      <div style="font-weight:700;font-size:0.95rem;color:#1f2937;">ออเดอร์ #' + orderId + ' ยังไม่เสร็จ</div>' +
        '      <div style="font-size:0.75rem;color:#6b7280;margin-top:2px;">แต้มและ Stamp จะยังถูกเพิ่มให้อัตโนมัติหลัง Approve</div>' +
        '    </div>' +
        '  </div>' +
        '  <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:0.75rem 0.875rem;margin-bottom:1.25rem;font-size:0.78rem;color:#92400e;line-height:1.6;">' +
        '    หากออกจากระบบตอนนี้ คุณจะ<strong>ไม่สามารถดูสถานะออเดอร์</strong>ได้อีก<br>' +
        '    แต้มสะสมและ Stamp จะยังคงเข้าบัญชีของคุณตามปกติ' +
        '  </div>' +
        '  <div style="display:flex;flex-direction:column;gap:0.625rem;">' +
        '    <button onclick="document.getElementById(\'logout-warning-modal\').remove()" ' +
        '            style="width:100%;padding:0.875rem;background:#6F4E37;color:#fff;border:none;border-radius:12px;font-weight:700;font-size:0.9rem;cursor:pointer;">' +
        '      ยังอยู่ที่ร้าน — ดูออเดอร์ต่อ' +
        '    </button>' +
        '    <a href="/Customer/Tracking?orderId=' + orderId + '" ' +
        '       onclick="document.getElementById(\'logout-warning-modal\').remove()" ' +
        '       style="width:100%;padding:0.875rem;background:#fff;color:#6F4E37;border:1.5px solid #C8A97E;border-radius:12px;font-weight:700;font-size:0.9rem;cursor:pointer;text-align:center;text-decoration:none;display:block;">' +
        '      ไปหน้าติดตามออเดอร์' +
        '    </a>' +
        '    <button onclick="window.location.href=\'/Customer/MemberLogout?force=true\'" ' +
        '            style="width:100%;padding:0.75rem;background:transparent;color:#9ca3af;border:none;font-size:0.82rem;cursor:pointer;">' +
        '      ออกจากระบบต่อไป (แต้มยังได้รับอยู่)' +
        '    </button>' +
        '  </div>' +
        '</div>';
    modal.addEventListener('click', function(e) {
        if (e.target === modal) modal.remove();
    });
    document.body.appendChild(modal);
}
</script>

</html>
