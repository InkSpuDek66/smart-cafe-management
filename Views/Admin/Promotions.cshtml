@* Views/Admin/Promotions.cshtml *@
@model List<Project_CSI402_T2_Y3.Models.Db.Promotion>
@{
    ViewData["Title"] = "โปรโมชั่น";
    Layout = "_AdminLayout";
    var promoUsage = ViewBag.PromoUsage as Dictionary<int, int> ?? new Dictionary<int, int>();

    // แปลง ConditionType + RewardType เป็นข้อความไทยที่อ่านแล้วเข้าใจทันที
    string DescribeCondition(string? cType, string? cVal) => cType switch
    {
        "MinAmount"    => $"ยอดสั่งครบ {cVal} บาท",
        "StampCount"   => $"สะสมครบ {cVal} ดวง",
        "Birthday"     => "วันเกิดของสมาชิก",
        "GroupCheckin" => $"มากับกลุ่ม ≥{cVal} คน + Check-in",
        "Seasonal"     => "เมนูตามเทศกาล/ฤดูกาล",
        _              => "ไม่มีเงื่อนไข (อัตโนมัติ)"
    };

    string DescribeReward(string? rType, string? rVal) => rType switch
    {
        "PointEarn"    => "บวกแต้มสะสม 10 บาท = 1 แต้ม",
        "FreeItem"     => $"รับสินค้าฟรี (รหัสเมนู {rVal})",
        "FreeDrink"    => "รับเครื่องดื่มฟรี 1 แก้ว",
        "Discount"     => $"ลดราคา {rVal} บาท",
        "SeasonalMenu" => "เปิดขายเมนูพิเศษตามเทศกาล",
        _              => rVal ?? "—"
    };

    // แปลง ConditionType+RewardType กลับเป็น wizard select value สำหรับ Edit form
    string WizardValue(string? cType, string? rType) => (cType, rType) switch
    {
        (null or "", "PointEarn")    => "auto",
        ("MinAmount",  "FreeItem")   => "min_free",
        ("MinAmount",  "Discount")   => "min_discount",
        ("StampCount", "FreeDrink")  => "stamp",
        ("Birthday",   "Discount")   => "birthday",
        ("GroupCheckin","Discount")  => "group",
        ("Seasonal",  "SeasonalMenu")=> "seasonal",
        _                            => "auto"
    };
}

<div class="flex items-center justify-between mb-5">
    <h1 class="font-['Inter'] text-2xl font-bold text-[#6F4E37]">โปรโมชั่น</h1>
    <button type="button" onclick="toggleAddPanel()"
            class="btn btn-sm bg-[#6F4E37] text-white border-none font-bold">
        + เพิ่มโปรโมชั่น
    </button>
</div>

<!-- ===== ฟอร์มเพิ่ม/แก้ไขโปรโมชั่น ===== -->
<div id="promoFormPanel" class="hidden mb-6">
    <div class="admin-card" id="promoFormCard">
        <div class="admin-card-header" id="promoFormHeader">เพิ่มโปรโมชั่นใหม่</div>
        <div class="admin-card-body">

            <form id="promoForm" asp-controller="Admin" asp-action="AddPromotion" method="post">

                <!-- hidden id สำหรับ Edit mode -->
                <input type="hidden" name="promotionId" id="fPromoId" />
                <!-- hidden fields ที่ JS จะ set ให้อัตโนมัติ — staff ไม่ต้องเห็น -->
                <input type="hidden" name="conditionType"  id="fConditionType" />
                <input type="hidden" name="rewardType"     id="fRewardType" />

                <div class="grid gap-5 sm:grid-cols-2">

                    <!-- ① ชื่อโปรโมชั่น -->
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-bold text-gray-700 mb-1">
                            ชื่อโปรโมชั่น <span class="text-red-500">*</span>
                        </label>
                        <input type="text" name="promotionName" id="fPromoName" required
                               placeholder="เช่น คุกกี้ฟรีเมื่อยอดครบ 300 บาท"
                               class="w-full border border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-white outline-none focus:border-[#6F4E37]" />
                        <div class="text-[0.7rem] text-gray-400 mt-0.5">ชื่อที่แสดงในรายการโปรโมชั่น</div>
                    </div>

                    <!-- ② เลือกประเภทโปรโมชั่น — staff เห็นแค่ตัวนี้ ไม่ต้องรู้ ConditionType/RewardType -->
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-bold text-gray-700 mb-1">
                            ประเภทโปรโมชั่น <span class="text-red-500">*</span>
                        </label>
                        <select id="wizardSelect" onchange="onWizardChange()"
                                class="w-full border border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-white outline-none focus:border-[#6F4E37]">
                            <option value="">— เลือกประเภท —</option>
                            <option value="auto">สะสมแต้ม — ซื้อทุก 10 บาท ได้ 1 แต้ม (อัตโนมัติ)</option>
                            <option value="min_free">ยอดครบกำหนด → รับสินค้า/เมนูฟรี</option>
                            <option value="min_discount">ยอดครบกำหนด → ลดราคา</option>
                            <option value="stamp">Stamp Card — สะสมครบจำนวน → รับเครื่องดื่มฟรี</option>
                            <option value="birthday">วันเกิดสมาชิก → ลดราคาพิเศษ</option>
                            <option value="group">Group Check-in (≥ X คน + Social Media) → ลดราคา</option>
                            <option value="seasonal">เมนูพิเศษตามเทศกาล / ฤดูกาล</option>
                        </select>
                    </div>

                    <!-- ③ กลุ่มฟิลด์ที่แสดงตามประเภทที่เลือก -->

                    <!-- ยอดขั้นต่ำ (สำหรับ min_free, min_discount) -->
                    <div id="field_minAmount" class="hidden">
                        <label class="block text-sm font-bold text-gray-700 mb-1">ยอดสั่งซื้อขั้นต่ำ (บาท)</label>
                        <input type="number" name="conditionValue" id="fConditionValue_minAmount"
                               min="1" placeholder="เช่น 300"
                               class="w-full border border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-white outline-none focus:border-[#6F4E37]" />
                        <div class="text-[0.7rem] text-gray-400 mt-0.5">ลูกค้าต้องสั่งรวมอย่างน้อยเท่านี้จึงจะได้รับสิทธิ์</div>
                    </div>

                    <!-- รหัสเมนูฟรี (สำหรับ min_free) -->
                    <div id="field_freeItem" class="hidden">
                        <label class="block text-sm font-bold text-gray-700 mb-1">รหัสเมนูที่แถมฟรี</label>
                        <input type="number" name="rewardValue" id="fRewardValue_freeItem"
                               min="1" placeholder="เช่น 18 (Chocolate Chip Cookie)"
                               class="w-full border border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-white outline-none focus:border-[#6F4E37]" />
                        <div class="text-[0.7rem] text-amber-600 mt-0.5 font-medium">ดูรหัสเมนูได้ที่หน้า จัดการเมนู → คอลัมน์ #</div>
                    </div>

                    <!-- จำนวนเงินที่ลด (สำหรับ min_discount, birthday, group) -->
                    <div id="field_discountAmt" class="hidden">
                        <label class="block text-sm font-bold text-gray-700 mb-1">ลดราคากี่บาท</label>
                        <input type="number" name="rewardValue" id="fRewardValue_discount"
                               min="1" placeholder="เช่น 50"
                               class="w-full border border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-white outline-none focus:border-[#6F4E37]" />
                        <div class="text-[0.7rem] text-gray-400 mt-0.5">จำนวนเงินที่หักออกจากยอดรวม (บาท)</div>
                    </div>

                    <!-- จำนวนแสตมป์ (สำหรับ stamp) -->
                    <div id="field_stampCount" class="hidden">
                        <label class="block text-sm font-bold text-gray-700 mb-1">ต้องสะสมกี่ดวงจึงได้สิทธิ์</label>
                        <input type="number" name="conditionValue" id="fConditionValue_stamp"
                               min="1" placeholder="เช่น 10"
                               class="w-full border border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-white outline-none focus:border-[#6F4E37]" />
                        <div class="text-[0.7rem] text-gray-400 mt-0.5">1 ออเดอร์ = 1 ดวง รับเครื่องดื่มฟรี 1 แก้วเมื่อครบ</div>
                    </div>

                    <!-- จำนวนคนขั้นต่ำ (สำหรับ group) -->
                    <div id="field_groupSize" class="hidden">
                        <label class="block text-sm font-bold text-gray-700 mb-1">จำนวนคนขั้นต่ำในกลุ่ม</label>
                        <input type="number" name="conditionValue" id="fConditionValue_group"
                               min="2" placeholder="เช่น 5"
                               class="w-full border border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-white outline-none focus:border-[#6F4E37]" />
                        <div class="text-[0.7rem] text-gray-400 mt-0.5">ลูกค้าต้องมาเป็นกลุ่มอย่างน้อยเท่านี้ และ Check-in บน Facebook/Instagram</div>
                    </div>

                    <!-- วันเริ่ม-สิ้นสุด (สำหรับ seasonal) -->
                    <div id="field_startDate" class="hidden">
                        <label class="block text-sm font-bold text-gray-700 mb-1">วันเริ่มเทศกาล <span class="font-normal text-gray-400">(ค.ศ.)</span></label>
                        <input type="date" name="startDate" id="fStartDate"
                               class="w-full border border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-white outline-none focus:border-[#6F4E37]" />
                    </div>

                    <div id="field_endDate" class="hidden">
                        <label class="block text-sm font-bold text-gray-700 mb-1">วันสิ้นสุดเทศกาล <span class="font-normal text-gray-400">(ค.ศ.)</span></label>
                        <input type="date" name="endDate" id="fEndDate"
                               class="w-full border border-[#d9c9b6] rounded-lg px-3 py-2.5 text-sm bg-white outline-none focus:border-[#6F4E37]" />
                        <div class="text-[0.7rem] text-gray-400 mt-0.5">เมนู Seasonal จะซ่อนตัวเองหลังวันนี้โดยอัตโนมัติ</div>
                    </div>

                </div>

                <!-- Preview — แสดงสรุปโปรโมชั่นก่อนบันทึก -->
                <div id="promoPreview" class="hidden mt-4 px-4 py-3 bg-green-50 border border-green-200 rounded-lg text-[0.82rem] text-green-800 leading-relaxed">
                    <span class="font-bold">สรุป: </span><span id="promoPreviewText"></span>
                </div>

                <div class="flex gap-2 mt-5">
                    <button type="submit" id="promoSubmitBtn"
                            class="btn btn-sm bg-[#6F4E37] text-white border-none font-bold flex-1">
                        บันทึก
                    </button>
                    <button type="button" onclick="closePromoPanel()"
                            class="btn btn-sm btn-ghost border border-gray-300">
                        ยกเลิก
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<!-- Modal ยืนยันลบ -->
<dialog id="deletePromoModal" class="modal">
    <div class="modal-box max-w-sm" style="color-scheme:light;background:#ffffff;color:#1f2937;">
        <h3 class="text-base font-bold text-red-700 mb-2">ยืนยันลบโปรโมชั่น</h3>
        <p class="text-[0.85rem] mb-4" style="color:#374151;">
            ลบ <strong id="deletePromoName" style="color:#1f2937;"></strong>?<br/>
            <span class="text-[0.78rem]" style="color:#6b7280;">ประวัติการใช้งานที่ผ่านมาจะไม่ถูกลบ</span>
        </p>
        <form asp-controller="Admin" asp-action="DeletePromotion" method="post">
            <input type="hidden" name="promotionId" id="deletePromoId" />
            <div class="modal-action mt-0">
                <button type="button" onclick="document.getElementById('deletePromoModal').close()"
                        class="btn btn-sm btn-ghost">ยกเลิก</button>
                <button type="submit" class="btn btn-sm bg-red-600 text-white border-none">ลบ</button>
            </div>
        </form>
    </div>
    <div class="modal-backdrop" onclick="document.getElementById('deletePromoModal').close()"></div>
</dialog>

<!-- ===== รายการโปรโมชั่น ===== -->
<div class="admin-card">
    <div class="admin-card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-10 text-center text-gray-400 text-sm">ยังไม่มีโปรโมชั่นในระบบ</div>
        }
        else
        {
            <table class="table table-zebra w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b-2 border-gray-200">
                        <th class="px-4 py-2.5 text-left font-bold text-gray-500 text-xs uppercase">โปรโมชั่น</th>
                        <th class="px-4 py-2.5 text-left font-bold text-gray-500 text-xs uppercase">เงื่อนไขที่ได้รับ</th>
                        <th class="px-4 py-2.5 text-left font-bold text-gray-500 text-xs uppercase">สิ่งที่ลูกค้าได้รับ</th>
                        <th class="px-4 py-2.5 text-left font-bold text-gray-500 text-xs uppercase">ช่วงเวลา</th>
                        <th class="px-4 py-2.5 text-center font-bold text-gray-500 text-xs uppercase">ใช้แล้ว</th>
                        <th class="px-4 py-2.5 text-center font-bold text-gray-500 text-xs uppercase">สถานะ</th>
                        <th class="px-4 py-2.5 text-center font-bold text-gray-500 text-xs uppercase">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        bool isActive = p.IsActive == (ulong)1;
                        string condText   = DescribeCondition(p.ConditionType, p.ConditionValue);
                        string rewardText = DescribeReward(p.RewardType, p.RewardValue);
                        string wizVal     = WizardValue(p.ConditionType, p.RewardType);

                        <tr class="border-b border-gray-100 @(!isActive ? "opacity-50" : "")">

                            <!-- ชื่อโปรโมชั่น -->
                            <td class="px-4 py-3">
                                <div class="font-bold text-gray-800">@p.PromotionName</div>
                                <div class="text-[0.7rem] text-gray-400 mt-0.5">#@p.PromotionId</div>
                            </td>

                            <!-- เงื่อนไข — Thai text -->
                            <td class="px-4 py-3">
                                <span class="text-gray-700 text-[0.82rem]">@condText</span>
                            </td>

                            <!-- รางวัล — Thai text -->
                            <td class="px-4 py-3">
                                <span class="text-[#6F4E37] font-semibold text-[0.82rem]">@rewardText</span>
                            </td>

                            <!-- ช่วงเวลา -->
                            <td class="px-4 py-3 text-[0.78rem] text-gray-500">
                                @if (p.StartDate.HasValue || p.EndDate.HasValue)
                                {
                                    <div>@(p.StartDate?.ToString("d MMM yy") ?? "—")</div>
                                    <div class="text-gray-400">ถึง @(p.EndDate?.ToString("d MMM yy") ?? "ไม่กำหนด")</div>
                                }
                                else
                                {
                                    <span class="text-gray-400">ไม่จำกัดเวลา</span>
                                }
                            </td>

                            <!-- จำนวนครั้งที่ใช้ -->
                            <td class="px-4 py-3 text-center">
                                <span class="text-base font-bold text-[#6F4E37]">
                                    @promoUsage.GetValueOrDefault(p.PromotionId, 0)
                                </span>
                                <div class="text-[0.68rem] text-gray-400">ครั้ง</div>
                            </td>

                            <!-- Toggle เปิด/ปิด -->
                            <td class="px-4 py-3 text-center">
                                <form asp-controller="Admin" asp-action="TogglePromotion" method="post" class="inline">
                                    <input type="hidden" name="promotionId" value="@p.PromotionId" />
                                    <button type="submit"
                                            class="btn btn-xs @(isActive ? "btn-error" : "btn-success") font-bold">
                                        @(isActive ? "ปิด" : "เปิด")
                                    </button>
                                </form>
                                <div class="text-[0.68rem] mt-0.5 @(isActive ? "text-green-600" : "text-gray-400") font-semibold">
                                    @(isActive ? "เปิดใช้งาน" : "ปิดใช้งาน")
                                </div>
                            </td>

                            <!-- แก้ไข / ลบ -->
                            <td class="px-4 py-3 text-center">
                                <div class="flex gap-1.5 justify-center">
                                    <button type="button" onclick="openEditPanel(this)"
                                            class="btn btn-xs btn-warning font-bold"
                                            data-id="@p.PromotionId"
                                            data-name="@p.PromotionName"
                                            data-wizard="@wizVal"
                                            data-cond-val="@(p.ConditionValue ?? "")"
                                            data-reward-val="@(p.RewardValue ?? "")"
                                            data-start="@(p.StartDate?.ToString("yyyy-MM-dd") ?? "")"
                                            data-end="@(p.EndDate?.ToString("yyyy-MM-dd") ?? "")">
                                        แก้ไข
                                    </button>
                                    <button type="button" onclick="openDeleteModal(this)"
                                            class="btn btn-xs btn-error font-bold"
                                            data-id="@p.PromotionId"
                                            data-name="@p.PromotionName">
                                        ลบ
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<script>
// ============================================================
// Wizard — mapping ระหว่าง select value กับ ConditionType/RewardType จริงใน DB
// ============================================================
var wizardMap = {
    'auto'         : { cType: '',             rType: 'PointEarn'   },
    'min_free'     : { cType: 'MinAmount',    rType: 'FreeItem'    },
    'min_discount' : { cType: 'MinAmount',    rType: 'Discount'    },
    'stamp'        : { cType: 'StampCount',   rType: 'FreeDrink'   },
    'birthday'     : { cType: 'Birthday',     rType: 'Discount'    },
    'group'        : { cType: 'GroupCheckin', rType: 'Discount'    },
    'seasonal'     : { cType: 'Seasonal',     rType: 'SeasonalMenu'}
};

// กลุ่ม field ที่ต้องแสดงตาม wizard value
var fieldsByWizard = {
    'auto'         : [],
    'min_free'     : ['field_minAmount', 'field_freeItem'],
    'min_discount' : ['field_minAmount', 'field_discountAmt'],
    'stamp'        : ['field_stampCount'],
    'birthday'     : ['field_discountAmt'],
    'group'        : ['field_groupSize', 'field_discountAmt'],
    'seasonal'     : ['field_startDate', 'field_endDate']
};

var allFields = ['field_minAmount','field_freeItem','field_discountAmt',
                 'field_stampCount','field_groupSize','field_startDate','field_endDate'];

// preview text ตาม wizard
function buildPreview(wVal) {
    var cVal  = getActiveCondVal();
    var rVal  = getActiveRewardVal();
    switch (wVal) {
        case 'auto':         return 'ซื้อทุก 10 บาท ได้ 1 แต้มสะสม (ไม่ต้องทำอะไรเพิ่ม)';
        case 'min_free':     return 'ยอดสั่งครบ ' + (cVal||'?') + ' บาท → รับเมนูฟรี (รหัส ' + (rVal||'?') + ')';
        case 'min_discount': return 'ยอดสั่งครบ ' + (cVal||'?') + ' บาท → ลด ' + (rVal||'?') + ' บาท';
        case 'stamp':        return 'สะสมครบ ' + (cVal||'?') + ' ดวง → รับเครื่องดื่มฟรี 1 แก้ว';
        case 'birthday':     return 'วันเกิดสมาชิก → ลด ' + (rVal||'?') + ' บาท';
        case 'group':        return 'มาเป็นกลุ่ม ≥' + (cVal||'?') + ' คน + Check-in Social → ลด ' + (rVal||'?') + ' บาท';
        case 'seasonal':     return 'เปิดขายเมนู Seasonal ตั้งแต่ ' + (document.getElementById('fStartDate')?.value||'?') + ' ถึง ' + (document.getElementById('fEndDate')?.value||'?');
        default:             return '';
    }
}

function getActiveCondVal() {
    return document.getElementById('fConditionValue_minAmount')?.value
        || document.getElementById('fConditionValue_stamp')?.value
        || document.getElementById('fConditionValue_group')?.value
        || '';
}

function getActiveRewardVal() {
    return document.getElementById('fRewardValue_freeItem')?.value
        || document.getElementById('fRewardValue_discount')?.value
        || '';
}

function onWizardChange() {
    var wVal = document.getElementById('wizardSelect').value;

    // ซ่อน field ทั้งหมด + clear required
    allFields.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) {
            el.classList.add('hidden');
            el.querySelectorAll('input').forEach(function (inp) {
                inp.removeAttribute('required');
                inp.value = '';
            });
        }
    });

    // แสดง field ที่ต้องการ + set required
    (fieldsByWizard[wVal] || []).forEach(function (id) {
        var el = document.getElementById(id);
        if (el) {
            el.classList.remove('hidden');
            el.querySelectorAll('input[type="number"], input[type="text"]').forEach(function (inp) {
                inp.setAttribute('required', '');
            });
        }
    });

    // set hidden ConditionType + RewardType
    var map = wizardMap[wVal] || { cType: '', rType: '' };
    document.getElementById('fConditionType').value = map.cType;
    document.getElementById('fRewardType').value    = map.rType;

    // update preview
    updatePreview(wVal);
}

function updatePreview(wVal) {
    var preview = document.getElementById('promoPreview');
    var text    = buildPreview(wVal);
    if (wVal && text) {
        document.getElementById('promoPreviewText').textContent = text;
        preview.classList.remove('hidden');
    } else {
        preview.classList.add('hidden');
    }
}

// ติด event listener กับ input ทั้งหมดเพื่อ live update preview
document.addEventListener('DOMContentLoaded', function () {
    allFields.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) {
            el.querySelectorAll('input').forEach(function (inp) {
                inp.addEventListener('input', function () {
                    updatePreview(document.getElementById('wizardSelect').value);
                });
            });
        }
    });

    // เมื่อ submit ให้ sync ค่า conditionValue จาก field ที่ active ไปยัง hidden input (ถ้ามี)
    // conditionValue และ rewardValue ถูกส่งตรงจาก input[name] แต่มีชื่อต่างกัน ต้องรวมก่อน submit
    document.getElementById('promoForm').addEventListener('submit', function () {
        // sync conditionValue: ใช้ field ที่ visible
        var cVal = document.getElementById('fConditionValue_minAmount')?.value
                || document.getElementById('fConditionValue_stamp')?.value
                || document.getElementById('fConditionValue_group')?.value
                || '';
        // sync rewardValue: ใช้ field ที่ visible
        var rVal = document.getElementById('fRewardValue_freeItem')?.value
                || document.getElementById('fRewardValue_discount')?.value
                || '';

        // หา/สร้าง hidden input conditionValue + rewardValue แล้ว set ค่า
        setHidden('conditionValue', cVal);
        setHidden('rewardValue',    rVal);
    });
});

function setHidden(name, val) {
    var inp = document.querySelector('input[name="' + name + '"]:not([type="number"])');
    if (!inp) {
        inp = document.createElement('input');
        inp.type = 'hidden';
        inp.name = name;
        document.getElementById('promoForm').appendChild(inp);
    }
    inp.value = val;
    // ปิด required บน number inputs เพื่อไม่ให้ browser block submit
    document.querySelectorAll('input[name="' + name + '"][type="number"]').forEach(function (el) {
        el.removeAttribute('name');
    });
}

// ============================================================
// Panel open/close
// ============================================================
var isEditMode = false;

function toggleAddPanel() {
    var panel = document.getElementById('promoFormPanel');
    if (!panel.classList.contains('hidden') && !isEditMode) {
        closePromoPanel();
    } else {
        isEditMode = false;
        resetForm();
        document.getElementById('promoFormHeader').textContent = 'เพิ่มโปรโมชั่นใหม่';
        document.getElementById('promoFormCard').className = 'admin-card';
        document.getElementById('promoForm').action = '/Admin/AddPromotion';
        panel.classList.remove('hidden');
        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}

function closePromoPanel() {
    document.getElementById('promoFormPanel').classList.add('hidden');
    isEditMode = false;
    resetForm();
}

function resetForm() {
    document.getElementById('fPromoId').value   = '';
    document.getElementById('fPromoName').value = '';
    document.getElementById('wizardSelect').value = '';
    document.getElementById('fConditionType').value = '';
    document.getElementById('fRewardType').value    = '';
    allFields.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) {
            el.classList.add('hidden');
            el.querySelectorAll('input').forEach(function (inp) { inp.value = ''; inp.removeAttribute('required'); });
        }
    });
    document.getElementById('promoPreview').classList.add('hidden');
}

function openEditPanel(btn) {
    isEditMode = true;
    var d = btn.dataset;
    resetForm();

    document.getElementById('fPromoId').value   = d.id;
    document.getElementById('fPromoName').value = d.name;
    document.getElementById('wizardSelect').value = d.wizard;
    onWizardChange();

    // ใส่ค่าลงในช่องที่ visible
    var condVal   = d.condVal;
    var rewardVal = d.rewardVal;
    var wVal      = d.wizard;

    if (wVal === 'min_free' || wVal === 'min_discount') {
        var el = document.getElementById('fConditionValue_minAmount');
        if (el) el.value = condVal;
    }
    if (wVal === 'min_free') {
        var el = document.getElementById('fRewardValue_freeItem');
        if (el) el.value = rewardVal;
    }
    if (wVal === 'min_discount' || wVal === 'birthday' || wVal === 'group') {
        var el = document.getElementById('fRewardValue_discount');
        if (el) el.value = rewardVal;
    }
    if (wVal === 'stamp') {
        var el = document.getElementById('fConditionValue_stamp');
        if (el) el.value = condVal;
    }
    if (wVal === 'group') {
        var el = document.getElementById('fConditionValue_group');
        if (el) el.value = condVal;
    }
    if (wVal === 'seasonal') {
        var s = document.getElementById('fStartDate');
        var e = document.getElementById('fEndDate');
        if (s) s.value = d.start;
        if (e) e.value = d.end;
    }

    updatePreview(wVal);

    document.getElementById('promoFormHeader').textContent = 'แก้ไขโปรโมชั่น';
    document.getElementById('promoFormCard').className = 'admin-card border-2 border-amber-300';
    document.getElementById('promoForm').action = '/Admin/EditPromotion';

    var panel = document.getElementById('promoFormPanel');
    panel.classList.remove('hidden');
    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function openDeleteModal(btn) {
    document.getElementById('deletePromoId').value         = btn.dataset.id;
    document.getElementById('deletePromoName').textContent = btn.dataset.name;
    document.getElementById('deletePromoModal').showModal();
}
</script>
