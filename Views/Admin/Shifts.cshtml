@* Views/Admin/Shifts.cshtml *@
@* ------------------------------------------------
- หน้าจัดการกะทำงานพนักงาน (Staff Shifts)
- Manager/Owner เห็นกะของทุกคน + เพิ่ม/ลบได้
- Barista/Cashier เห็นและจัดการกะของตัวเองได้
- URL เข้าถึง: /Admin/Shifts
- Method: GET (แสดงรายการ), POST (AddShift, ClockOut, DeleteShift)
------------------------------------------------ *@

@using System.Globalization
@{
    ViewData["Title"] = "กะทำงาน";
    Layout = "_AdminLayout";

    var shifts        = ViewBag.Shifts     as IEnumerable<dynamic>;
    var allStaff      = ViewBag.AllStaff   as IEnumerable<Project_CSI402_T2_Y3.Models.Db.Staff>;
    var openShift     = ViewBag.OpenShift  as Project_CSI402_T2_Y3.Models.Db.Staffshift;
    int currentStaffId = ViewBag.CurrentStaffId ?? 0;
    int roleId         = ViewBag.RoleId ?? 0;
    bool isManagerUp   = roleId == 3 || roleId == 5;

    // ใช้ InvariantCulture เพื่อให้ได้ปี ค.ศ. จริง ป้องกัน Thai culture แปลงปีเป็น พ.ศ. ก่อน submit
    var nowIso  = DateTime.Now.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
    var nowDate = DateTime.Now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var nowTime = DateTime.Now.ToString("HH:mm", CultureInfo.InvariantCulture);
    var nowThai = $"{DateTime.Now:dd/MM/}{DateTime.Now.Year + 543} พ.ศ.";

    // เวลา Login ของ session — ใช้สำหรับปุ่มเช็คอินอัตโนมัติ
    string? loginTimeIso = ViewBag.LoginTime as string;
    string loginTimeThai = "";
    string loginTimeDisplay = "";
    if (!string.IsNullOrEmpty(loginTimeIso) && DateTime.TryParse(loginTimeIso, CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var loginDt))
    {
        loginTimeThai   = $"{loginDt:dd/MM/}{loginDt.Year + 543} เวลา {loginDt:HH:mm} พ.ศ.";
        loginTimeDisplay = loginDt.ToString("HH:mm", CultureInfo.InvariantCulture);
    }
}

<div class="grid grid-cols-[340px_1fr] gap-6 items-start">

    <!-- ===== ฝั่งซ้าย: บัตรกะ + ฟอร์ม ===== -->
    <div class="flex flex-col gap-4">

        @if (openShift == null)
        {
            <!-- ยังไม่ได้เช็คอิน -->
            <div class="admin-card">
                <div class="admin-card-header">
                    <span>เช็คอินเข้างาน</span>
                </div>
                <div class="admin-card-body">
                    @if (!string.IsNullOrEmpty(loginTimeIso))
                    {
                        <!-- ปุ่มเช็คอินด่วนจากเวลา Login — ไม่ส่ง staffId, controller ใช้ค่าจาก session แทน -->
                        <form asp-controller="Admin" asp-action="AddShift" method="post" class="mb-4">
                            <input type="hidden" name="shiftStart" value="@loginTimeIso" />
                            <div class="bg-green-50 border border-green-200 rounded-lg px-3.5 py-3 mb-2">
                                <div class="text-[0.72rem] text-green-700 font-bold uppercase tracking-wide mb-0.5">เช็คอินอัตโนมัติจากเวลา Login</div>
                                <div class="text-[0.85rem] text-green-900 font-semibold">@loginTimeThai</div>
                            </div>
                            <button type="submit"
                                    class="w-full bg-green-700 text-white border-none py-2.5 rounded-lg text-sm font-bold cursor-pointer hover:bg-green-800 transition-colors">
                                เช็คอินตั้งแต่ @loginTimeDisplay น. (เวลา Login)
                            </button>
                        </form>
                        <div class="flex items-center gap-2 mb-4">
                            <div class="flex-1 h-px bg-gray-200"></div>
                            <span class="text-[0.72rem] text-gray-400 font-semibold">หรือกำหนดเวลาเอง</span>
                            <div class="flex-1 h-px bg-gray-200"></div>
                        </div>
                    }
                    <form asp-controller="Admin" asp-action="AddShift" method="post">
                        @if (isManagerUp)
                        {
                            <div class="mb-3">
                                <label class="block text-[0.75rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1">พนักงาน</label>
                                <select name="staffId"
                                        class="select select-bordered w-full bg-[#fefaf6] border-[#d9c9b6] text-sm">
                                    @if (allStaff != null)
                                    {
                                        @foreach (var s in allStaff)
                                        {
                                            <option value="@s.StaffId">@s.FirstName @s.LastName (@s.StaffId)</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        <!-- hidden field ส่งค่า ISO ค.ศ. จริงเข้า Controller -->
                        <input type="hidden" name="shiftStart" id="hiddenShiftStart1" value="@nowIso" />
                        <div class="mb-3">
                            <label class="block text-[0.75rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1">วันที่เริ่มกะ</label>
                            <input type="date" id="shiftStartDate1" value="@nowDate"
                                   class="input input-bordered w-full bg-[#fefaf6] border-[#d9c9b6] text-sm mb-1"
                                   onchange="showShiftThaiDate(1)" />
                            <input type="time" id="shiftStartTime1" value="@nowTime"
                                   class="input input-bordered w-full bg-[#fefaf6] border-[#d9c9b6] text-sm"
                                   onchange="showShiftThaiDate(1)" />
                            <div id="shiftThaiLabel1" class="text-[0.72rem] text-amber-700 font-semibold mt-1">@nowThai</div>
                        </div>
                        <button type="submit"
                                class="w-full bg-[#6F4E37] text-white border-none py-2.5 rounded-lg text-sm font-bold cursor-pointer hover:bg-[#5a3e2b] transition-colors">
                            เช็คอินเข้างาน
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <!-- กำลังทำงานอยู่ — แสดงบัตรกะปัจจุบัน -->
            var shiftStart = openShift.ShiftStart ?? DateTime.Now;
            var elapsed    = DateTime.Now - shiftStart;
            // แสดงวันที่เป็น พ.ศ. โดยใช้ Thai culture (server culture)
            var shiftStartDisplay = shiftStart.ToString("dd/MM/yyyy HH:mm");
            <div class="rounded-xl overflow-hidden border border-green-300"
                 style="background:linear-gradient(135deg,#166534,#15803d);">
                <div class="px-5 py-4 text-white">
                    <div class="text-[0.72rem] uppercase tracking-widest opacity-70 mb-1">กะปัจจุบัน — กำลังทำงาน</div>
                    <div class="text-[1.4rem] font-bold font-['Inter'] leading-none mb-3">
                        @((int)elapsed.TotalHours) ชม. @elapsed.Minutes นาที
                    </div>
                    <div class="text-[0.8rem] opacity-80">เริ่มเมื่อ @shiftStartDisplay</div>
                </div>
                <div class="px-5 pb-4">
                    <form asp-controller="Admin" asp-action="ClockOut" method="post">
                        <input type="hidden" name="shiftId" value="@openShift.ShiftId" />
                        <button type="submit"
                                onclick="return confirm('ยืนยันปิดกะทำงาน?')"
                                class="w-full bg-white text-green-800 border-none py-2.5 rounded-lg text-sm font-bold cursor-pointer hover:bg-green-50 transition-colors">
                            ปิดกะ — เลิกงาน
                        </button>
                    </form>
                </div>
            </div>

            @if (isManagerUp)
            {
                <!-- Manager/Owner: เพิ่มกะให้พนักงานคนอื่น -->
                <div class="admin-card">
                    <div class="admin-card-header">เพิ่มกะพนักงานคนอื่น</div>
                    <div class="admin-card-body">
                        <form asp-controller="Admin" asp-action="AddShift" method="post">
                            <div class="mb-3">
                                <label class="block text-[0.75rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1">พนักงาน</label>
                                <select name="staffId"
                                        class="select select-bordered w-full bg-[#fefaf6] border-[#d9c9b6] text-sm">
                                    @if (allStaff != null)
                                    {
                                        @foreach (var s in allStaff)
                                        {
                                            <option value="@s.StaffId">@s.FirstName @s.LastName (@s.StaffId)</option>
                                        }
                                    }
                                </select>
                            </div>
                            <input type="hidden" name="shiftStart" id="hiddenShiftStart2" value="@nowIso" />
                            <div class="mb-3">
                                <label class="block text-[0.75rem] font-bold text-[#6F4E37] uppercase tracking-wide mb-1">วันที่เริ่มกะ</label>
                                <input type="date" id="shiftStartDate2" value="@nowDate"
                                       class="input input-bordered w-full bg-[#fefaf6] border-[#d9c9b6] text-sm mb-1"
                                       onchange="showShiftThaiDate(2)" />
                                <input type="time" id="shiftStartTime2" value="@nowTime"
                                       class="input input-bordered w-full bg-[#fefaf6] border-[#d9c9b6] text-sm"
                                       onchange="showShiftThaiDate(2)" />
                                <div id="shiftThaiLabel2" class="text-[0.72rem] text-amber-700 font-semibold mt-1">@nowThai</div>
                            </div>
                            <button type="submit"
                                    class="w-full bg-gray-600 text-white border-none py-2.5 rounded-lg text-sm font-bold cursor-pointer hover:bg-gray-700 transition-colors">
                                เพิ่มกะ
                            </button>
                        </form>
                    </div>
                </div>
            }
        }

    </div>

    <!-- ===== ฝั่งขวา: ตารางประวัติกะ ===== -->
    <div class="admin-card">
        <div class="admin-card-header">ประวัติกะ (50 รายการล่าสุด)</div>
        <div class="overflow-x-auto">
            @if (shifts == null || !((IEnumerable<dynamic>)shifts).Any())
            {
                <div class="text-center text-gray-400 p-10 text-sm">ไม่มีข้อมูลกะทำงาน</div>
            }
            else
            {
                <table class="w-full text-[0.82rem]">
                    <thead>
                        <tr class="bg-[#f5ede3] border-b border-[#e8d5bf]">
                            <th class="text-left px-4 py-2.5 text-[0.72rem] font-bold text-[#6F4E37] uppercase tracking-wide">พนักงาน</th>
                            <th class="text-left px-4 py-2.5 text-[0.72rem] font-bold text-[#6F4E37] uppercase tracking-wide">เริ่มกะ</th>
                            <th class="text-left px-4 py-2.5 text-[0.72rem] font-bold text-[#6F4E37] uppercase tracking-wide">สิ้นสุดกะ</th>
                            <th class="text-center px-3 py-2.5 text-[0.72rem] font-bold text-[#6F4E37] uppercase tracking-wide">รวม (ชม.)</th>
                            @if (isManagerUp)
                            {
                                <th class="px-3 py-2.5"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in shifts)
                        {
                            bool isOpen = s.IsOpen;

                            // แปลง dynamic → DateTime? เพื่อป้องกัน Razor render raw string
                            DateTime? dtStart = s.ShiftStart is DateTime ss ? (DateTime?)ss : null;
                            DateTime? dtEnd   = s.ShiftEnd   is DateTime se ? (DateTime?)se : null;

                            double hours = (!isOpen && dtStart.HasValue && dtEnd.HasValue)
                                ? (dtEnd.Value - dtStart.Value).TotalHours
                                : 0;

                            <tr class="border-b border-[#f0e4d4] hover:bg-[#fdf8f3] transition-colors @(isOpen ? "bg-green-50" : "")">
                                <td class="px-4 py-3">
                                    <span class="font-semibold text-[#3E2723]">@s.StaffName</span>
                                    @if (isOpen)
                                    {
                                        <span class="ml-1.5 inline-block bg-green-100 text-green-700 text-[0.68rem] font-bold px-1.5 py-0.5 rounded-full">กำลังทำงาน</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-gray-600 whitespace-nowrap">
                                    @if (dtStart.HasValue)
                                    {
                                        <span class="block font-semibold text-gray-700">@dtStart.Value.ToString("dd/MM/yyyy")</span>
                                        <span class="text-gray-400 text-[0.75rem]">@dtStart.Value.ToString("HH:mm")</span>
                                    }
                                    else { <span class="text-gray-300">—</span> }
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    @if (isOpen)
                                    {
                                        <div class="flex items-center gap-1.5">
                                            @if ((int)s.StaffId == currentStaffId)
                                            {
                                                <form asp-controller="Admin" asp-action="ClockOut" method="post" class="inline">
                                                    <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                                    <button type="submit"
                                                            onclick="return confirm('ปิดกะของคุณ?')"
                                                            class="btn btn-xs bg-green-700 text-white border-none hover:bg-green-800">
                                                        ปิดกะ
                                                    </button>
                                                </form>
                                            }
                                            else if (isManagerUp)
                                            {
                                                <form asp-controller="Admin" asp-action="ClockOut" method="post" class="inline">
                                                    <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                                    <button type="submit"
                                                            onclick="return confirm('ปิดกะพนักงานคนนี้?')"
                                                            class="btn btn-xs bg-gray-500 text-white border-none hover:bg-gray-600">
                                                        ปิดกะ
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                    else if (dtEnd.HasValue)
                                    {
                                        <span class="block font-semibold text-gray-700">@dtEnd.Value.ToString("dd/MM/yyyy")</span>
                                        <span class="text-gray-400 text-[0.75rem]">@dtEnd.Value.ToString("HH:mm")</span>
                                    }
                                    else { <span class="text-gray-300">—</span> }
                                </td>
                                <td class="px-3 py-3 text-center">
                                    @if (!isOpen && hours > 0)
                                    {
                                        <span class="font-['Inter'] font-bold text-[#6F4E37]">@hours.ToString("F1")</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300">—</span>
                                    }
                                </td>
                                @if (isManagerUp)
                                {
                                    <td class="px-3 py-3 text-center">
                                        @if (!isOpen)
                                        {
                                            <form asp-controller="Admin" asp-action="DeleteShift" method="post" class="inline">
                                                <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                                <button type="submit"
                                                        onclick="return confirm('ลบกะนี้?')"
                                                        class="btn btn-xs btn-ghost text-red-500 font-bold hover:bg-red-50">
                                                    ลบ
                                                </button>
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>

<script>
    // แสดง label พ.ศ. หลังเลือกวันจาก picker (date input คืน ISO ค.ศ. เสมอ → บวก 543)
    function showShiftThaiDate(num) {
        var dateEl  = document.getElementById('shiftStartDate' + num);
        var timeEl  = document.getElementById('shiftStartTime' + num);
        var labelEl = document.getElementById('shiftThaiLabel' + num);
        var hiddenEl = document.getElementById('hiddenShiftStart' + num);
        if (!dateEl || !dateEl.value) { if (labelEl) labelEl.textContent = ''; return; }
        var parts  = dateEl.value.split('-');
        var yearCE = parseInt(parts[0], 10);
        if (labelEl) labelEl.textContent = parts[2] + '/' + parts[1] + '/' + (yearCE + 543) + ' พ.ศ.';
        // อัปเดต hidden field ทันที
        if (hiddenEl) hiddenEl.value = dateEl.value + 'T' + (timeEl ? timeEl.value : '00:00');
    }

    // combine date + time → hidden field ก่อน submit (รองรับกรณีที่ไม่ได้ trigger onchange)
    document.querySelectorAll('form').forEach(function(form) {
        form.addEventListener('submit', function() {
            [1, 2].forEach(function(num) {
                var dEl = document.getElementById('shiftStartDate' + num);
                var tEl = document.getElementById('shiftStartTime' + num);
                var hEl = document.getElementById('hiddenShiftStart' + num);
                if (dEl && dEl.value && hEl) hEl.value = dEl.value + 'T' + (tEl ? tEl.value : '00:00');
            });
        });
    });
</script>
