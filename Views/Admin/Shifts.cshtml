@* Views/Admin/Shifts.cshtml *@
@* ------------------------------------------------
- หน้าจัดการกะทำงานพนักงาน (Staff Shifts)
- Manager/Owner เห็นกะของทุกคน + เพิ่ม/ลบได้
- Barista/Cashier เห็นและจัดการกะของตัวเองได้
- URL เข้าถึง: /Admin/Shifts
- Method: GET (แสดงรายการ), POST (AddShift, ClockOut, DeleteShift)
------------------------------------------------ *@

@{
    ViewData["Title"] = "กะทำงาน";
    Layout = "_AdminLayout";

    var shifts        = ViewBag.Shifts     as IEnumerable<dynamic>;
    var allStaff      = ViewBag.AllStaff   as IEnumerable<Project_CSI402_T2_Y3.Models.Db.Staff>;
    var openShift     = ViewBag.OpenShift  as Project_CSI402_T2_Y3.Models.Db.Staffshift;
    int currentStaffId = ViewBag.CurrentStaffId ?? 0;
    int roleId         = ViewBag.RoleId ?? 0;
    bool isManagerUp   = roleId == 3 || roleId == 5;
}

<h1 class="font-['Inter'] text-[1.4rem] font-bold text-[#6F4E37] mb-4">
    กะทำงาน
</h1>


<div class="grid grid-cols-2 gap-6 items-start">

    <!-- ฝั่งซ้าย: ฟอร์มเช็คอิน / ข้อมูลกะปัจจุบัน -->
    <div>
        @if (openShift == null)
        {
            <!-- ฟอร์มเพิ่มกะใหม่ (เช็คอิน) -->
            <div class="bg-white border border-gray-200 rounded-xl p-5 mb-4">
                <h2 class="text-base font-bold text-[#6F4E37] mb-4">เช็คอินเข้างาน</h2>
                <form asp-controller="Admin" asp-action="AddShift" method="post">
                    @if (isManagerUp)
                    {
                        <!-- Manager/Owner เลือกพนักงานได้ -->
                        <div class="mb-3">
                            <label class="block text-xs font-bold text-[#6F4E37] mb-1">พนักงาน</label>
                            <select name="staffId"
                                    class="select select-bordered w-full bg-[#fefaf6] border-[#d9c9b6] text-sm">
                                @if (allStaff != null)
                                {
                                    @foreach (var s in allStaff)
                                    {
                                        <option value="@s.StaffId">@s.FirstName @s.LastName (@s.StaffId)</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    <div class="mb-4">
                        <label class="block text-xs font-bold text-[#6F4E37] mb-1">เวลาเริ่มกะ</label>
                        <input type="datetime-local" name="shiftStart"
                               value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                               class="input input-bordered w-full bg-[#fefaf6] border-[#d9c9b6] text-sm" />
                    </div>
                    <button type="submit"
                            class="btn btn-sm w-full bg-[#6F4E37] text-white border-none font-bold hover:bg-[#5a3e2b]">
                        เช็คอิน
                    </button>
                </form>
            </div>
        }
        else
        {
            <!-- แสดงกะที่กำลังทำงานอยู่ + ปุ่ม Clock Out -->
            <div class="bg-green-100 border border-green-300 rounded-xl p-5 mb-4">
                <h2 class="text-base font-bold text-green-800 mb-3">กะปัจจุบัน</h2>
                <p class="text-sm text-gray-700 mb-1">
                    เริ่ม: <strong>@openShift.ShiftStart?.ToString("dd/MM/yyyy HH:mm")</strong>
                </p>
                <p class="text-[0.8rem] text-gray-500 mb-4">
                    ระยะเวลา: @((DateTime.Now - (openShift.ShiftStart ?? DateTime.Now)).Hours) ชม.
                    @((DateTime.Now - (openShift.ShiftStart ?? DateTime.Now)).Minutes) นาที
                </p>
                <form asp-controller="Admin" asp-action="ClockOut" method="post">
                    <input type="hidden" name="shiftId" value="@openShift.ShiftId" />
                    <button type="submit"
                            onclick="return confirm('ยืนยันปิดกะทำงาน?')"
                            class="btn btn-sm w-full bg-green-800 text-white border-none font-bold hover:bg-green-900">
                        ปิดกะ
                    </button>
                </form>
            </div>

            @if (isManagerUp)
            {
                <!-- Manager/Owner ยังเพิ่มกะให้คนอื่นได้ -->
                <div class="bg-white border border-gray-200 rounded-xl p-5">
                    <h2 class="text-[0.9rem] font-bold text-[#6F4E37] mb-3">เพิ่มกะพนักงานอื่น</h2>
                    <form asp-controller="Admin" asp-action="AddShift" method="post">
                        <div class="mb-3">
                            <label class="block text-xs font-bold text-[#6F4E37] mb-1">พนักงาน</label>
                            <select name="staffId"
                                    class="select select-bordered w-full bg-[#fefaf6] border-[#d9c9b6] text-sm">
                                @if (allStaff != null)
                                {
                                    @foreach (var s in allStaff)
                                    {
                                        <option value="@s.StaffId">@s.FirstName @s.LastName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="block text-xs font-bold text-[#6F4E37] mb-1">เวลาเริ่มกะ</label>
                            <input type="datetime-local" name="shiftStart"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                   class="input input-bordered w-full bg-[#fefaf6] border-[#d9c9b6] text-sm" />
                        </div>
                        <button type="submit"
                                class="btn btn-sm w-full bg-gray-500 text-white border-none font-bold hover:bg-gray-600">
                            เพิ่มกะ
                        </button>
                    </form>
                </div>
            }
        }
    </div>

    <!-- ฝั่งขวา: ตารางประวัติกะ -->
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <div class="px-4 py-3 bg-amber-100 border-b border-amber-200">
            <span class="font-bold text-sm text-amber-800">ประวัติกะ (50 รายการล่าสุด)</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full border-collapse text-[0.82rem]">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200">
                        <th class="px-3 py-2 text-left font-bold text-gray-700">พนักงาน</th>
                        <th class="px-3 py-2 text-left font-bold text-gray-700">เริ่มกะ</th>
                        <th class="px-3 py-2 text-left font-bold text-gray-700">สิ้นสุดกะ</th>
                        <th class="px-3 py-2 text-center font-bold text-gray-700">ชั่วโมง</th>
                        @if (isManagerUp)
                        {
                            <th class="px-3 py-2 text-center font-bold text-gray-700"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (shifts != null)
                    {
                        @foreach (var s in shifts)
                        {
                            bool isOpen  = s.IsOpen;
                            double hours = isOpen
                                ? 0
                                : ((DateTime)s.ShiftEnd - (DateTime)s.ShiftStart).TotalHours;

                            <tr class="border-b border-gray-100 @(isOpen ? "bg-green-50" : "")">
                                <td class="px-3 py-2 text-gray-900 @(isOpen ? "font-bold" : "font-normal")">
                                    @s.StaffName
                                </td>
                                <td class="px-3 py-2 text-gray-700">
                                    @((DateTime?)s.ShiftStart)?.ToString("dd/MM HH:mm")
                                </td>
                                <td class="px-3 py-2">
                                    @if (isOpen)
                                    {
                                        <span class="text-emerald-600 font-bold text-xs">กำลังทำงาน</span>
                                        if (s.StaffId == currentStaffId)
                                        {
                                            <!-- ปุ่ม Clock Out สำหรับกะของตัวเอง -->
                                            <form asp-controller="Admin" asp-action="ClockOut" method="post" class="inline ml-2">
                                                <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                                <button type="submit"
                                                        onclick="return confirm('ปิดกะ?')"
                                                        class="btn btn-xs bg-emerald-600 text-white border-none hover:bg-emerald-700">
                                                    ออก
                                                </button>
                                            </form>
                                        }
                                        else if (isManagerUp)
                                        {
                                            <form asp-controller="Admin" asp-action="ClockOut" method="post" class="inline ml-2">
                                                <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                                <button type="submit"
                                                        onclick="return confirm('ปิดกะพนักงานคนนี้?')"
                                                        class="btn btn-xs bg-gray-500 text-white border-none hover:bg-gray-600">
                                                    ปิดกะ
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-gray-700">@((DateTime?)s.ShiftEnd)?.ToString("dd/MM HH:mm")</span>
                                    }
                                </td>
                                <td class="px-3 py-2 text-center text-gray-500">
                                    @if (!isOpen)
                                    {
                                        @hours.ToString("F1")
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">—</span>
                                    }
                                </td>
                                @if (isManagerUp)
                                {
                                    <td class="px-3 py-2 text-center">
                                        @if (!isOpen)
                                        {
                                            <form asp-controller="Admin" asp-action="DeleteShift" method="post" class="inline">
                                                <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                                <button type="submit"
                                                        onclick="return confirm('ลบกะนี้?')"
                                                        class="btn btn-xs btn-ghost text-red-500 font-bold hover:bg-red-50">
                                                    ลบ
                                                </button>
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (shifts == null || !((IEnumerable<dynamic>)shifts).Any())
            {
                <div class="text-center text-gray-400 p-8 text-sm">ไม่มีข้อมูลกะทำงาน</div>
            }
        </div>
    </div>

</div>
