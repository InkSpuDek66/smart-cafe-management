@* Views/Admin/MenuList.cshtml *@
@* ------------------------------------------------
- หน้าแสดงรายการเมนูทั้งหมด (สำหรับ Admin)
- แสดงข้อมูล: รูปภาพ, ชื่อเมนู, หมวดหมู่, ราคา, สถานะ (เปิดขาย/ปิดชั่วคราว), Seasonal (ใช่/ไม่ใช่)
- ปุ่มจัดการ: แก้ไข, ลบ (มีการยืนยันก่อนลบ)
- ปุ่มเพิ่มเมนูใหม่ที่นำไปสู่หน้า /Admin/MenuCreate
- ใช้ Layout เฉพาะสำหรับ Admin เพื่อความแตกต่างจากหน้าของ Staff และ Member
- URL เข้าถึง: /Admin/MenuList
- Method: GET (แสดงรายการเมนู)
- ViewModel: AdminMenuListViewModel (มี properties: List<MenuItemViewModel> Items, string? SuccessMessage, string? ErrorMessage)
- Controller Action: AdminController.MenuList (GET)
------------------------------------------------ *@

@model Project_CSI402_T2_Y3.ViewModels.AdminMenuListViewModel
@using Project_CSI402_T2_Y3.ViewModels
@{
    ViewData["Title"] = "รายการเมนู";
    Layout = "_AdminLayout";
}

<div class="flex justify-between items-center mb-4">
    <div>
        <p class="text-gray-500 text-sm mt-[2px]">ทั้งหมด @Model.Items.Count รายการ</p>
    </div>
    <a asp-controller="Admin" asp-action="MenuCreate" class="btn-cf-primary">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        เพิ่มเมนูใหม่
    </a>
</div>


<div class="admin-card">
    <div class="overflow-x-auto">
        <table class="admin-table w-full border-collapse">
            <thead>
                <tr>
                    <th class="w-[60px]">รูป</th>
                    <th>ชื่อเมนู</th>
                    <th>หมวด</th>
                    <th>ราคา</th>
                    <th>สถานะ</th>
                    <th>ฤดูกาล</th>
                    <th class="w-[140px]">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.MenuName"
                                     class="w-12 h-12 object-cover rounded-md"
                                     onerror="this.src='https://placehold.co/48x48/EFE0C9/6F4E37?text=?'" />
                            }
                            else
                            {
                                <div class="w-12 h-12 bg-[#EFE0C9] rounded-md flex items-center justify-center text-[0.6rem] text-[#8D6748] text-center">ไม่มีรูป</div>
                            }
                        </td>
                        <td>
                            <div class="font-bold">@item.MenuName</div>
                            @if (!string.IsNullOrEmpty(item.MenuDescription))
                            {
                                <div class="text-[0.72rem] text-gray-400 max-w-[220px] overflow-hidden text-ellipsis whitespace-nowrap">
                                    @item.MenuDescription
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge badge-warning text-[#6F4E37] bg-[#EFE0C9] border-0 text-xs font-bold">
                                @MenuFormViewModel.GetThaiName(item.Category)
                            </span>
                        </td>
                        <td class="font-bold text-[#6F4E37]">@item.Price?.ToString("N0")฿</td>
                        <td>
                            <!-- ปุ่ม Toggle + badge สถานะในแถวเดียว -->
                            <form asp-controller="Admin" asp-action="ToggleMenuAvailability"
                                  asp-route-id="@item.MenuItemId" method="post"
                                  class="inline-flex items-center gap-1.5">
                                @if (item.IsAvailable == (ulong)1)
                                {
                                    <span class="status-badge badge-success">เปิดขาย</span>
                                    <button type="submit"
                                            class="btn btn-xs border border-[#d9c9b6] text-gray-500 bg-white font-bold"
                                            title="ปิดชั่วคราว">ปิด</button>
                                }
                                else
                                {
                                    <span class="status-badge badge-error">ปิดชั่วคราว</span>
                                    <button type="submit"
                                            class="btn btn-xs bg-green-600 text-white border-none font-bold"
                                            title="เปิดขาย">เปิด</button>
                                }
                            </form>
                        </td>
                        <td>
                            @if (item.IsSeasonal == (ulong)1)
                            {
                                bool expired = item.SeasonEndDate.HasValue && item.SeasonEndDate.Value < DateTime.Now;
                                @if (expired)
                                {
                                    <span class="status-badge badge-error" title="หมดอายุแล้ว">หมดอายุ</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-warning">ฤดูกาล</span>
                                }
                            }
                            else
                            {
                                <span class="text-gray-300">—</span>
                            }
                        </td>
                        <td>
                            <div class="flex gap-[0.4rem]">
                                <a asp-controller="Admin" asp-action="MenuEdit" asp-route-id="@item.MenuItemId"
                                   class="btn-cf-outline px-3 py-[0.3rem] text-[0.78rem]">แก้ไข</a>

                                <form asp-controller="Admin" asp-action="MenuDelete" asp-route-id="@item.MenuItemId"
                                      method="post" onsubmit="return confirm('ลบเมนู @item.MenuName?')">
                                    <button type="submit" class="btn-cf-primary btn-danger px-3 py-[0.3rem] text-[0.78rem]">ลบ</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-gray-400 py-10">ยังไม่มีเมนู</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
