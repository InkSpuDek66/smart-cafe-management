@* Views/Home/Dashboard.cshtml *@
@* ------------------------------------------------
- หน้า Dashboard สำหรับ Staff และ Admin
- แสดงสถิติสำคัญ เช่น ยอดขายวันนี้, จำนวนออเดอร์วันนี้, จำนวนสมาชิกทั้งหมด, จำนวนเมนูที่เปิดขาย
- แสดงแจ้งเตือนวัตถุดิบที่มีสต็อกต่ำ (ถ้ามี)
- แสดงข้อมูลสรุประบบ เช่น จำนวนพนักงาน, จำนวนเมนูทั้งหมด, จำนวนเมนูที่เปิดขาย
- ปุ่มลัดสำหรับเข้าถึงหน้าจัดการสมาชิก, ดูเมนู, เพิ่มพนักงาน
- URL เข้าถึง: /Home/Dashboard
- Method: GET
- ViewModel: DashboardViewModel (มี properties: TodayOrderCount, TodayRevenue, TotalMembers, TotalMenuItems, ActiveMenuItems, LowStockAlerts)
- Controller Action: HomeController.Dashboard (GET)
------------------------------------------------ *@

@model Project_CSI402_T2_Y3.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-[#C8A97E] font-bold mb-1">ภาพรวมระบบ</p>
    <h1 class="cf-page-title">Dashboard</h1>
    <p class="cf-page-subtitle">วันที่ @DateTime.Today.ToString("dd MMMM yyyy")</p>
</div>

<!-- Stats Row -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">

    <div class="cf-stat-card">
        <div class="cf-stat-label">ออเดอร์วันนี้</div>
        <div class="cf-stat-value">@Model.TodayOrderCount</div>
        <div class="cf-stat-desc">รายการทั้งหมด</div>
    </div>

    <!-- รายได้ใช้สีเขียวอ่อนแยกออกมา -->
    <div class="cf-stat-card border-l-4 border-green-500">
        <div class="cf-stat-label">รายได้วันนี้</div>
        <div class="cf-stat-value text-green-700">
            @Model.TodayRevenue.ToString("N0")
        </div>
        <div class="cf-stat-desc">บาท (เฉพาะที่ชำระแล้ว)</div>
    </div>

    <div class="cf-stat-card">
        <div class="cf-stat-label">สมาชิก</div>
        <div class="cf-stat-value">@Model.TotalMembers</div>
        <div class="cf-stat-desc">คนในระบบ</div>
    </div>

    <div class="cf-stat-card">
        <div class="cf-stat-label">เมนูที่เปิดขาย</div>
        <div class="cf-stat-value">@Model.ActiveMenuItems</div>
        <div class="cf-stat-desc">จากทั้งหมด @Model.TotalMenuItems รายการ</div>
    </div>

</div>

<!-- Bottom Row -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Low Stock Alerts -->
    <div class="card shadow-sm rounded-xl overflow-hidden">
        <div class="cf-card-header flex justify-between items-center">
            <span>แจ้งเตือนวัตถุดิบต่ำ</span>
            @if (Model.LowStockAlerts.Any())
            {
                <span class="badge badge-error text-white text-xs font-bold">@Model.LowStockAlerts.Count</span>
            }
        </div>
        <div class="card-body pt-4">
            @if (!Model.LowStockAlerts.Any())
            {
                <div class="alert alert-success">
                    <span>วัตถุดิบทุกรายการอยู่ในระดับปกติ</span>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="table table-sm table-zebra w-full">
                        <thead>
                            <tr>
                                <th>วัตถุดิบ</th>
                                <th class="text-right">คงเหลือ</th>
                                <th class="text-right">ระดับแจ้งเตือน</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.LowStockAlerts)
                            {
                                <tr>
                                    <td class="text-red-700 font-semibold">@item.IngredientName</td>
                                    <td class="text-right font-mono text-red-700">
                                        @item.StockQuantity.ToString("F1") @item.Unit
                                    </td>
                                    <td class="text-right font-mono text-[#8D6748]">
                                        @item.ReorderLevel.ToString("F1") @item.Unit
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- System Summary -->
    <div class="card shadow-sm rounded-xl overflow-hidden">
        <div class="cf-card-header">ข้อมูลระบบ</div>
        <div class="card-body pt-4">
            <ul class="flex flex-col gap-3.5">
                <li class="flex justify-between items-center pb-3.5 border-b border-[#EFE0C9]">
                    <span class="text-[0.9rem] text-[#8D6748]">สมาชิกทั้งหมด</span>
                    <span class="font-bold text-[#3E2723]">@Model.TotalMembers คน</span>
                </li>
                <li class="flex justify-between items-center pb-3.5 border-b border-[#EFE0C9]">
                    <span class="text-[0.9rem] text-[#8D6748]">พนักงานที่ใช้งาน</span>
                    <span class="font-bold text-[#3E2723]">@Model.TotalStaff คน</span>
                </li>
                <li class="flex justify-between items-center pb-3.5 border-b border-[#EFE0C9]">
                    <span class="text-[0.9rem] text-[#8D6748]">เมนูทั้งหมด</span>
                    <span class="font-bold text-[#3E2723]">@Model.TotalMenuItems รายการ</span>
                </li>
                <li class="flex justify-between items-center pb-3.5 border-b border-[#EFE0C9]">
                    <span class="text-[0.9rem] text-[#8D6748]">เมนูที่เปิดขาย</span>
                    <span class="font-bold text-green-700">@Model.ActiveMenuItems รายการ</span>
                </li>
                <li class="flex justify-between items-center pb-3.5 border-b border-[#EFE0C9]">
                    <span class="text-[0.9rem] text-[#8D6748]">เมนูที่ปิดชั่วคราว</span>
                    <span class="font-bold text-red-700">@(Model.TotalMenuItems - Model.ActiveMenuItems) รายการ</span>
                </li>
            </ul>

            <div class="flex flex-wrap gap-2 mt-5">
                <a asp-controller="Account" asp-action="MemberList" class="btn btn-sm btn-outline">จัดการสมาชิก</a>
                <a asp-controller="Menu"    asp-action="Index"       class="btn btn-sm btn-outline">ดูเมนู</a>
                <a asp-controller="Account" asp-action="AddStaff"    class="btn btn-sm btn-outline">เพิ่มพนักงาน</a>
            </div>
        </div>
    </div>

</div>
